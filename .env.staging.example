# Copy to the APPLICATION ROOT .env, outside the domain document root. Never commit it.
NODE_ENV=production
INSTALLATION_COMPANY_ID=1
APP_BASE_URL=https://staging.example.invalid
APP_HOST=127.0.0.1
# Passenger manages its internal listener. Set PORT only if the provider supplies one.
# PORT=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ACCOUNT_waec_staging
DB_USER=ACCOUNT_waec_stageuser
DB_PASSWORD=
SESSION_SECRET=
RESET_TOKEN_SECRET=
SESSION_COOKIE_NAME=hrpayroll.sid
SESSION_MAX_AGE_MS=28800000
SESSION_CLEANUP_INTERVAL_MS=900000
SESSION_CLEANUP_BATCH_SIZE=100
SHUTDOWN_TIMEOUT_MS=30000
# Confirm the exact provider proxy topology; do not assume one hop without checking.
TRUST_PROXY_HOPS=1
PRIVATE_UPLOAD_DIR=/home/ACCOUNT/waec-staging-private/uploads
TZ=Africa/Freetown
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
EMAIL_NOTIFICATIONS_ENABLED=false
ACCOUNT_EMAIL_ENABLED=false
# SMTP is read from this .env file only, never inherited from the application manager.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set true temporarily ONLY for an explicit empty-database initialization command.
STAGING_SETUP_ENABLED=false
STAGING_DB_NAME=ACCOUNT_waec_staging
# Logs go to provider-managed stdout/stderr. Configure restricted retention/rotation
# in cPanel/CloudLinux; this app does not consume a fictional LOG_DIR variable.
