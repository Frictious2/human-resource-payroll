<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Finance Manager Overview</h2>
                    <div class="text-muted">Read-only payroll, yearly-payment, reversal, and correction oversight for <%= pageData.company.Com_Name || 'your company' %>.</div>
                </div>
                <% if (pageData.latestActiveBatch) { %>
                    <div class="text-end">
                        <div class="small text-muted">Current Payroll</div>
                        <div class="fw-semibold">
                            <%= String(pageData.latestActiveBatch.PMonth || '').padStart(2, '0') %>/<%= pageData.latestActiveBatch.PYear || '' %> ·
                            <%= pageData.latestActiveBatch.PType || '' %> ·
                            Generation <%= pageData.latestActiveBatch.GenerationNo || 1 %>
                        </div>
                        <span class="badge <%= getStatusBadgeClass(pageData.latestActiveBatch.Status) %>"><%= pageData.latestActiveBatch.Status %></span>
                    </div>
                <% } %>
            </div>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger shadow-sm"><%= errorMessage %></div>
            <% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted small">Current Payroll Period</div>
                            <div class="fs-4 fw-semibold"><%= pageData.cards.currentPayrollMonth || 'No payroll batch yet' %></div>
                            <div class="small text-muted">Latest active generation and workflow period.</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Staff Processed</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.totalStaffInLatestPayroll || 0).toLocaleString() %></div></div></div>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Gross Payroll</div><div class="fs-5 fw-semibold"><%= Number(pageData.cards.latestGrossPayroll || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Net Payroll</div><div class="fs-5 fw-semibold"><%= Number(pageData.cards.latestNetPayroll || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div>
                </div>
                <div class="col-6 col-md-3 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Current Workflow Status</div><div class="mt-2"><span class="badge <%= getStatusBadgeClass(pageData.latestActiveBatch?.Status || '') %>"><%= pageData.latestActiveBatch?.Status || 'NO_BATCH' %></span></div></div></div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=CORRECTION_IN_PROGRESS" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Correction In Progress</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.correctionInProgress || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=SUBMITTED_TO_MANAGER" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Awaiting Manager</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.underManagerReview || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=SUBMITTED_TO_AUDITOR" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Awaiting Auditor</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.underAuditorReview || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=SUBMITTED_TO_ENTITY_HEAD" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Awaiting Entity Head</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.awaitingFinalApproval || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=FINAL_APPROVED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Approved / Ready</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.readyForPosting || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=POSTED_TO_ACCOUNTS" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Posted to Accounts</div><div class="fs-3 fw-semibold"><%= Number(pageData.cards.alreadyPosted || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/workflow?status=REVERSED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Reversed</div><div class="fs-3 fw-semibold"><%= Number(pageData.reversalCounts.REVERSED || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance-manager/payroll/reopen?status=REOPENED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Corrected Generations</div><div class="fs-3 fw-semibold"><%= Number(pageData.reopenCounts.REOPENED || 0) %></div></div></a>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header"><span class="fw-semibold">Current-Year Yearly Payments</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-end">Staff</th>
                                <th class="text-end">Total Amount</th>
                                <th>Submitted By</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pageData.yearlyOverview.forEach((item) => { %>
                                <tr>
                                    <td><%= item.label %> (<%= item.code %>)</td>
                                    <td><span class="badge <%= item.status === 'APPLIED' ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : item.status.includes('RETURNED') ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : item.status === 'NOT_PREPARED' ? 'bg-light text-dark border' : 'bg-info-subtle text-info-emphasis border border-info-subtle' %>"><%= item.displayStatus %></span></td>
                                    <td class="text-end"><%= Number(item.totalStaff || 0).toLocaleString() %></td>
                                    <td class="text-end"><%= Number(item.totalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td><%= item.submittedBy %></td>
                                    <td><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString('en-GB') : '-' %></td>
                                    <td class="text-end">
                                        <% if (item.batchId) { %>
                                            <a href="/finance-manager/payroll/yearly-payments/<%= item.batchId %>" class="btn btn-sm btn-outline-primary">Open</a>
                                        <% } else { %>
                                            <span class="text-muted small">No batch yet</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Recent Payroll Batches</span>
                            <a href="/finance-manager/payroll/workflow" class="small text-decoration-none">Open oversight list</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Period</th>
                                        <th>Activity</th>
                                        <th>Generation</th>
                                        <th>Status</th>
                                        <th class="text-end">Staff</th>
                                        <th class="text-end">Gross</th>
                                        <th class="text-end">Net</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!pageData.recentBatches.length) { %>
                                        <tr><td colspan="7" class="text-center text-muted py-4">No payroll workflow batches are available yet.</td></tr>
                                    <% } %>
                                    <% pageData.recentBatches.forEach((batch) => { %>
                                        <tr>
                                            <td><a href="/finance-manager/payroll/workflow/<%= batch.id %>" class="text-decoration-none fw-semibold"><%= String(batch.PMonth).padStart(2, '0') %>/<%= batch.PYear %></a></td>
                                            <td><%= batch.PType %></td>
                                            <td><%= batch.GenerationNo || 1 %></td>
                                            <td><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></td>
                                            <td class="text-end"><%= Number(batch.TotalStaff || 0).toLocaleString() %></td>
                                            <td class="text-end"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                            <td class="text-end"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Oversight Alerts</span></div>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Reversal Requests In Progress</span>
                                <span class="badge text-bg-secondary"><%= Number((pageData.reversalCounts.SUBMITTED_TO_MANAGER || 0) + (pageData.reversalCounts.SUBMITTED_TO_AUDITOR || 0) + (pageData.reversalCounts.SUBMITTED_TO_ENTITY_HEAD || 0) + (pageData.reversalCounts.FINAL_APPROVED || 0) + (pageData.reversalCounts.READY_TO_EXECUTE || 0)) %></span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Payroll Reopen Requests</span>
                                <span class="badge text-bg-secondary"><%= Number((pageData.reopenCounts.SUBMITTED_TO_MANAGER || 0) + (pageData.reopenCounts.SUBMITTED_TO_AUDITOR || 0) + (pageData.reopenCounts.SUBMITTED_TO_ENTITY_HEAD || 0) + (pageData.reopenCounts.READY_TO_REOPEN || 0)) %></span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <span>Corrected Payroll Reposted</span>
                                <span class="badge text-bg-secondary"><%= Number(pageData.reopenCounts.REOPENED || 0) %></span>
                            </div>
                            <a href="/finance-manager/reports/payroll-liabilities" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Open Payroll Liabilities</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance-manager/reports/general-ledger" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Open General Ledger History</span><i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mt-4 py-3 text-center text-muted border-top">
                <%- include('partials/footer') %>
            </footer>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
