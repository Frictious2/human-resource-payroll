<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · Finance Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>
    <% const reversalRequest = detail && detail.reversalDetail && detail.reversalDetail.request ? detail.reversalDetail.request : {}; %>
    <main class="main">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h3 mb-1">Payroll Reopen Request #<%= detail.request.id %></h1>
                    <p class="text-muted mb-0"><%= String(detail.request.PMonth).padStart(2, '0') %>/<%= detail.request.PYear %> · <%= detail.request.PType %> · Gen <%= detail.request.OriginalGenerationNo %> → Gen <%= detail.request.ProposedGenerationNo %></p>
                </div>
                <a href="/finance-manager/payroll/reopen" class="btn btn-outline-secondary">Back to Reopen Oversight</a>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><span class="fw-semibold">Request Summary</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Status:</strong> <span class="badge <%= getStatusBadgeClass(detail.request.Status) %>"><%= detail.request.Status %></span></div>
                            <div class="mb-2"><strong>Reason:</strong> <%= detail.request.Reason %></div>
                            <div class="mb-2"><strong>Requested By:</strong> <%= detail.request.RequestedBy %></div>
                            <div class="mb-2"><strong>Requested At:</strong> <%= detail.request.RequestedAt ? new Date(detail.request.RequestedAt).toLocaleString('en-GB') : 'N/A' %></div>
                            <div class="mb-2"><strong>Original Checksum:</strong> <small class="text-muted"><%= detail.request.OriginalPayrollChecksum %></small></div>
                            <div class="mb-0"><strong>Original Reversal Reference:</strong> <%= detail.request.OriginalReversalReference || 'N/A' %></div>
                        </div>
                    </div>
                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Generation Linkage</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Original Workflow Batch:</strong> #<%= detail.originalBatch.id %></div>
                            <div class="mb-2"><strong>Original Generation:</strong> <%= detail.originalBatch.GenerationNo || 1 %></div>
                            <div class="mb-2"><strong>Original Status:</strong> <span class="badge bg-danger text-white"><%= detail.originalBatch.Status %></span></div>
                            <div class="mb-2"><strong>Proposed Generation:</strong> <%= detail.request.ProposedGenerationNo %></div>
                            <div class="mb-0"><strong>New Workflow Batch:</strong> <%= detail.request.NewWorkflowBatchID ? `#${detail.request.NewWorkflowBatchID}` : 'Not yet created' %></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><span class="fw-semibold">Reversal Outcome</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Reversal Request:</strong> #<%= reversalRequest.id || 'N/A' %></div>
                            <div class="mb-2"><strong>Status:</strong> <%= reversalRequest.Status || 'N/A' %></div>
                            <div class="mb-2"><strong>Reversal Reference:</strong> <%= reversalRequest.ReversalBatchReference || 'N/A' %></div>
                            <div class="mb-0"><strong>Executed At:</strong> <%= reversalRequest.ExecutedAt ? new Date(reversalRequest.ExecutedAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Reopen Timeline</span></div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light"><tr><th>Action</th><th>Status</th><th>Actor</th><th>Date</th><th>Comments</th></tr></thead>
                                <tbody>
                                    <% if (!detail.actions.length) { %><tr><td colspan="5" class="text-center text-muted py-3">No reopen actions recorded yet.</td></tr><% } %>
                                    <% detail.actions.forEach((action) => { %>
                                        <tr>
                                            <td><%= action.Action %></td>
                                            <td><small><%= action.FromStatus || 'N/A' %> → <%= action.ToStatus %></small></td>
                                            <td><%= action.ActionBy %></td>
                                            <td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : 'N/A' %></td>
                                            <td><%= action.Comments || '—' %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
