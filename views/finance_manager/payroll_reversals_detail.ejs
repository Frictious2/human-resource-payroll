<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Finance Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div><h2 class="mb-1">Payroll Reversal Detail</h2><p class="text-muted mb-0">Workflow batch #<%= detail.request.WorkflowBatchID %> · GL batch #<%= detail.request.GLPostingBatchID || '—' %></p></div>
                <a href="/finance-manager/payroll/reversals" class="btn btn-outline-secondary">Back to Reversals</a>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Request Summary</span></div><div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge <%= detail.request.badgeClass %>"><%= detail.request.Status %></span></dd>
                            <dt class="col-sm-5">Period</dt><dd class="col-sm-7"><%= String(detail.request.PMonth).padStart(2, '0') %>/<%= detail.request.PYear %></dd>
                            <dt class="col-sm-5">Activity</dt><dd class="col-sm-7"><%= detail.request.PType %></dd>
                            <dt class="col-sm-5">Reason</dt><dd class="col-sm-7"><%= detail.request.Reason %></dd>
                            <dt class="col-sm-5">Requested By</dt><dd class="col-sm-7"><%= detail.request.RequestedBy %></dd>
                            <dt class="col-sm-5">Requested At</dt><dd class="col-sm-7"><%= detail.request.RequestedAt ? new Date(detail.request.RequestedAt).toLocaleString('en-GB') : '-' %></dd>
                            <dt class="col-sm-5">Executed At</dt><dd class="col-sm-7"><%= detail.request.ExecutedAt ? new Date(detail.request.ExecutedAt).toLocaleString('en-GB') : 'Not yet executed' %></dd>
                            <dt class="col-sm-5">Reversal Ref</dt><dd class="col-sm-7"><%= detail.request.ReversalBatchReference || 'Pending' %></dd>
                        </dl>
                    </div></div>
                </div>
                <div class="col-xl-8">
                    <div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Balanced Totals</span></div><div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4"><div class="text-muted small">Original Payroll Net</div><div class="fw-semibold"><%= Number(detail.workflowDetail?.batch?.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            <div class="col-md-4"><div class="text-muted small">Original GL Debit</div><div class="fw-semibold"><%= Number(detail.originalGlTotals?.debit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            <div class="col-md-4"><div class="text-muted small">Original GL Credit</div><div class="fw-semibold"><%= Number(detail.originalGlTotals?.credit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            <div class="col-md-4"><div class="text-muted small">Reversal GL Debit</div><div class="fw-semibold"><%= Number(detail.reversalGlTotals?.debit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            <div class="col-md-4"><div class="text-muted small">Reversal GL Credit</div><div class="fw-semibold"><%= Number(detail.reversalGlTotals?.credit || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            <div class="col-md-4"><div class="text-muted small">Execution Status</div><div class="fw-semibold"><%= detail.request.Status %></div></div>
                        </div>
                    </div></div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header"><span class="fw-semibold">Reversal Workflow Timeline</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light"><tr><th>When</th><th>Action</th><th>From</th><th>To</th><th>Actor</th><th>Comments</th></tr></thead>
                        <tbody>
                            <% if (!detail.actions.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No reversal actions are available yet.</td></tr><% } %>
                            <% detail.actions.forEach((entry) => { %>
                                <tr>
                                    <td><%= entry.ActionAt ? new Date(entry.ActionAt).toLocaleString('en-GB') : '-' %></td>
                                    <td><%= entry.Action %></td>
                                    <td><%= entry.FromStatus || '-' %></td>
                                    <td><%= entry.ToStatus || '-' %></td>
                                    <td><%= entry.ActionBy || '-' %></td>
                                    <td><%= entry.Comments || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
