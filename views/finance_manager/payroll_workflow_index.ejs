<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Finance Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1">Payroll Batches</h2>
                    <p class="text-muted mb-0">Read-only visibility into payroll workflow stages, generations, and totals.</p>
                </div>
            </div>
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form class="row g-3" method="GET" action="/finance-manager/payroll/workflow">
                        <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All</option><% statusOptions.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></div>
                        <div class="col-md-2"><label class="form-label">Month</label><input type="number" min="1" max="12" class="form-control" name="month" value="<%= filters.month %>"></div>
                        <div class="col-md-2"><label class="form-label">Year</label><input type="number" min="2000" max="2100" class="form-control" name="year" value="<%= filters.year %>"></div>
                        <div class="col-md-2"><label class="form-label">Activity</label><input type="text" class="form-control" name="pType" value="<%= filters.pType %>" placeholder="01"></div>
                        <div class="col-md-3 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary w-100">Filter</button><a href="/finance-manager/payroll/workflow" class="btn btn-outline-secondary">Reset</a></div>
                    </form>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Period</th>
                                <th>Activity</th>
                                <th>Generation</th>
                                <th>Status</th>
                                <th class="text-end">Staff</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Deductions</th>
                                <th class="text-end">Net</th>
                                <th>Processed By</th>
                                <th>Updated</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!batches.length) { %><tr><td colspan="11" class="text-center text-muted py-4">No payroll workflow batches matched the selected filters.</td></tr><% } %>
                            <% batches.forEach((batch) => { %>
                                <tr>
                                    <td class="fw-semibold"><%= String(batch.PMonth).padStart(2, '0') %>/<%= batch.PYear %></td>
                                    <td><%= batch.PType %></td>
                                    <td><%= batch.GenerationNo || 1 %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></td>
                                    <td class="text-end"><%= Number(batch.TotalStaff || 0).toLocaleString() %></td>
                                    <td class="text-end"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td><%= batch.processedByName || batch.ProcessedBy || 'N/A' %></td>
                                    <td><%= batch.UpdatedAt ? new Date(batch.UpdatedAt).toLocaleString('en-GB') : 'N/A' %></td>
                                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/finance-manager/payroll/workflow/<%= batch.id %>">Open</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
