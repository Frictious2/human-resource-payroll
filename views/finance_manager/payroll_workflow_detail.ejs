<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Finance Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h2 class="mb-1">Payroll Batch Detail</h2>
                    <p class="text-muted mb-0"><%= String(batch.PMonth).padStart(2, '0') %>/<%= batch.PYear %> · <%= batch.PType %> · Generation <%= batch.GenerationNo || 1 %></p>
                </div>
                <a href="/finance-manager/payroll/workflow" class="btn btn-outline-secondary">Back to Payroll Batches</a>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <% workflowTracker.forEach((stage) => { %>
                            <span class="badge <%= stage.current ? 'bg-primary text-white' : stage.completed ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : 'bg-light text-dark border' %>">
                                <%= stage.label %>
                            </span>
                            <% if (!stage.pending) { %><i class="bi bi-arrow-right text-muted"></i><% } %>
                        <% }) %>
                        <% if (batch.Status === 'REVERSED') { %><span class="badge bg-danger text-white">Reversed</span><% } %>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Batch Summary</span></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3"><div class="text-muted small">Status</div><div><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></div></div>
                                <div class="col-md-3"><div class="text-muted small">Company</div><div class="fw-semibold"><%= batch.companyName || batch.CompanyID %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Processed By</div><div class="fw-semibold"><%= batch.processedByName || batch.ProcessedBy || 'N/A' %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Processed At</div><div class="fw-semibold"><%= batch.ProcessedAt ? new Date(batch.ProcessedAt).toLocaleString('en-GB') : 'N/A' %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Total Staff</div><div class="fw-semibold"><%= Number(batch.TotalStaff || 0).toLocaleString() %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Gross</div><div class="fw-semibold"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Deductions</div><div class="fw-semibold"><%= Number(batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Net</div><div class="fw-semibold"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">PAYE</div><div class="fw-semibold"><%= Number(batch.TotalTax || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">NASSIT Employee</div><div class="fw-semibold"><%= Number(batch.TotalNassitEmployee || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">NASSIT Employer</div><div class="fw-semibold"><%= Number(batch.TotalNassitEmployer || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                                <div class="col-md-3"><div class="text-muted small">Posting Ref</div><div class="fw-semibold"><%= batch.glPostingBatchId ? `#${batch.glPostingBatchId}` : 'N/A' %></div></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Generation History</span></div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light"><tr><th>Generation</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                    <% generationHistory.forEach((item) => { %>
                                        <tr>
                                            <td><%= item.GenerationNo || 1 %></td>
                                            <td><span class="badge <%= getStatusBadgeClass(item.Status) %>"><%= item.Status %></span></td>
                                            <td class="text-end"><a href="/finance-manager/payroll/workflow/<%= item.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Reversal Visibility</span></div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light"><tr><th>Request</th><th>Status</th><th>Reason</th><th></th></tr></thead>
                                <tbody>
                                    <% if (!relatedReversals.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No reversal requests linked to this payroll period.</td></tr><% } %>
                                    <% relatedReversals.forEach((row) => { %>
                                        <tr>
                                            <td>#<%= row.id %></td>
                                            <td><span class="badge <%= row.badgeClass || 'bg-light text-dark border' %>"><%= row.Status %></span></td>
                                            <td><%= row.Reason || '-' %></td>
                                            <td class="text-end"><a href="/finance-manager/payroll/reversals/<%= row.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Reopen / Correction Visibility</span></div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light"><tr><th>Request</th><th>Status</th><th>Generation</th><th></th></tr></thead>
                                <tbody>
                                    <% if (!relatedReopens.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No reopen requests linked to this payroll period.</td></tr><% } %>
                                    <% relatedReopens.forEach((row) => { %>
                                        <tr>
                                            <td>#<%= row.id %></td>
                                            <td><span class="badge <%= getStatusBadgeClass(row.Status) %>"><%= row.Status %></span></td>
                                            <td><%= row.OriginalGenerationNo || 1 %> → <%= row.ProposedGenerationNo || '-' %></td>
                                            <td class="text-end"><a href="/finance-manager/payroll/reopen/<%= row.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header"><span class="fw-semibold">Payroll Rows</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>PFNo</th>
                                <th>Name</th>
                                <th>Dept</th>
                                <th>Grade</th>
                                <th>Job Title</th>
                                <th class="text-end">Salary</th>
                                <th class="text-end">Allowances</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">NASSIT</th>
                                <th class="text-end">Net</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!payrollRows.length) { %><tr><td colspan="10" class="text-center text-muted py-4">No payroll rows were found for this batch.</td></tr><% } %>
                            <% payrollRows.forEach((row) => { %>
                                <tr>
                                    <td><%= row.PFNo %></td>
                                    <td><%= row.StaffName %></td>
                                    <td><%= row.DeptName || row.DeptCode || '-' %></td>
                                    <td><%= row.GradeName || row.GradeCode || '-' %></td>
                                    <td><%= row.JobTitle || '-' %></td>
                                    <td class="text-end"><%= Number(row.Salary || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.AllowanceTotal || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.Tax || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.NassitEmployee || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.NetIncome || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header"><span class="fw-semibold">Workflow Timeline</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light"><tr><th>When</th><th>Action</th><th>From</th><th>To</th><th>Actor</th><th>Comments</th></tr></thead>
                        <tbody>
                            <% if (!history.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No workflow history is available for this batch yet.</td></tr><% } %>
                            <% history.forEach((entry) => { %>
                                <tr>
                                    <td><%= entry.ActionAt ? new Date(entry.ActionAt).toLocaleString('en-GB') : '-' %></td>
                                    <td><%= entry.Action %></td>
                                    <td><%= entry.FromStatus || '-' %></td>
                                    <td><%= entry.ToStatus || '-' %></td>
                                    <td><%= entry.ActionBy || '-' %></td>
                                    <td><%= entry.Comments || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
