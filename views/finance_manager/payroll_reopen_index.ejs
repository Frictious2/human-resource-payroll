<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Finance Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div><h2 class="mb-1">Reopened / Corrected Payroll</h2><p class="text-muted mb-0">Generation-aware visibility into reopened payroll and corrected processing cycles.</p></div>
            </div>
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light"><tr><th>Request</th><th>Period</th><th>Activity</th><th>Generation</th><th>Status</th><th>Requested By</th><th>Updated</th><th></th></tr></thead>
                        <tbody>
                            <% if (!requests.length) { %><tr><td colspan="8" class="text-center text-muted py-4">No reopen requests are available.</td></tr><% } %>
                            <% requests.forEach((row) => { %>
                                <tr>
                                    <td>#<%= row.id %></td>
                                    <td><%= String(row.PMonth).padStart(2, '0') %>/<%= row.PYear %></td>
                                    <td><%= row.PType %></td>
                                    <td><%= row.OriginalGenerationNo || 1 %> → <%= row.ProposedGenerationNo || '-' %></td>
                                    <td><span class="badge <%= getStatusBadgeClass(row.Status) %>"><%= row.Status %></span></td>
                                    <td><%= row.RequestedBy || '-' %></td>
                                    <td><%= row.UpdatedAt ? new Date(row.UpdatedAt).toLocaleString('en-GB') : '-' %></td>
                                    <td class="text-end"><a href="/finance-manager/payroll/reopen/<%= row.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
