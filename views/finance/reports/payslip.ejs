<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Finance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h3 mb-1"><%= title %></h1>
                    <p class="text-muted mb-0">Read-only payslip access for the currently active payroll generation.</p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form id="payslipForm" class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">Month</label>
                            <input type="number" min="1" max="12" class="form-control" id="month" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Year</label>
                            <input type="number" min="2000" max="2100" class="form-control" id="year" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Scope</label>
                            <select class="form-select" id="scope">
                                <option value="staff">Single Staff</option>
                                <option value="all">All Staff</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">PFNo</label>
                            <input type="text" class="form-control" id="pfno" placeholder="Leave blank when scope is All Staff">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="yearly">
                                <label class="form-check-label" for="yearly">Include yearly items</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-file-earmark-text me-2"></i>Generate Payslip</button>
                            <button type="button" class="btn btn-outline-secondary" id="printBtn" disabled>Print / Save PDF</button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="statusMessage" class="alert alert-info d-none"></div>
            <div id="payslipContainer" class="bg-white shadow p-4"></div>
        </div>
    </main>

    <script>
        const form = document.getElementById('payslipForm');
        const container = document.getElementById('payslipContainer');
        const printBtn = document.getElementById('printBtn');
        const statusMessage = document.getElementById('statusMessage');

        function fmtMoney(value) {
            return Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function setStatus(message, kind = 'info') {
            statusMessage.className = `alert alert-${kind}`;
            statusMessage.textContent = message;
            statusMessage.classList.remove('d-none');
        }

        function clearStatus() {
            statusMessage.classList.add('d-none');
            statusMessage.textContent = '';
        }

        function renderPayslipPage(company, period, row, yearlyTotals = []) {
            const deductions = Number(row.Tax || 0) + Number(row.NassitEmp || 0) + Number(row.GratEmp || 0) + Number(row.Ded1 || 0) + Number(row.Ded2 || 0) + Number(row.Ded3 || 0) + Number(row.Ded4 || 0) + Number(row.Ded5 || 0);
            const yearlyHtml = !yearlyTotals.length ? '' : `
                <div class="mt-4">
                    <h5>Yearly Payments</h5>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Item</th><th class="text-end">Amount</th><th class="text-end">Tax</th></tr></thead>
                        <tbody>
                            ${yearlyTotals.map((item) => `<tr><td>${item.label}</td><td class="text-end">${fmtMoney(item.amount)}</td><td class="text-end">${fmtMoney(item.tax)}</td></tr>`).join('')}
                        </tbody>
                    </table>
                </div>
            `;

            return `
                <div class="border rounded p-4 mb-4">
                    <div class="text-center mb-4">
                        <h3 class="mb-1">${company.name || 'Company'}</h3>
                        <div class="text-muted">${company.address || ''}</div>
                        <div class="fw-semibold mt-2">Payslip for ${period.month}/${period.year}</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><strong>PFNo:</strong> ${row.PFNo}</div>
                        <div class="col-md-4"><strong>Name:</strong> ${row.SName || ''}</div>
                        <div class="col-md-4"><strong>Account:</strong> ${row.AccountNo || ''}</div>
                        <div class="col-md-4"><strong>Department:</strong> ${row.DeptName || ''}</div>
                        <div class="col-md-4"><strong>Job Title:</strong> ${row.JobTitleName || ''}</div>
                    </div>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Component</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            <tr><td>Basic Salary</td><td class="text-end">${fmtMoney(row.Salary)}</td></tr>
                            <tr><td>Total Income</td><td class="text-end">${fmtMoney(row.TotalIncome)}</td></tr>
                            <tr><td>Taxable</td><td class="text-end">${fmtMoney(row.Taxable)}</td></tr>
                            <tr><td>Tax</td><td class="text-end">${fmtMoney(row.Tax)}</td></tr>
                            <tr><td>NASSIT Employee</td><td class="text-end">${fmtMoney(row.NassitEmp)}</td></tr>
                            <tr><td>Gratuity Employee</td><td class="text-end">${fmtMoney(row.GratEmp)}</td></tr>
                            <tr><td>Other Deductions</td><td class="text-end">${fmtMoney(deductions - Number(row.Tax || 0) - Number(row.NassitEmp || 0) - Number(row.GratEmp || 0))}</td></tr>
                            <tr class="fw-semibold"><td>Net Income</td><td class="text-end">${fmtMoney(row.NetIncome)}</td></tr>
                        </tbody>
                    </table>
                    ${yearlyHtml}
                </div>
            `;
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            clearStatus();
            container.innerHTML = '';
            printBtn.disabled = true;

            const month = document.getElementById('month').value;
            const year = document.getElementById('year').value;
            const scope = document.getElementById('scope').value;
            const pfno = document.getElementById('pfno').value.trim();
            const yearly = document.getElementById('yearly').checked ? '1' : '0';

            if (scope === 'staff' && !pfno) {
                setStatus('PFNo is required when the scope is Single Staff.', 'warning');
                return;
            }

            const url = `/finance/api/reports/payslip?month=${encodeURIComponent(month)}&year=${encodeURIComponent(year)}&scope=${encodeURIComponent(scope)}&pfno=${encodeURIComponent(pfno)}&yearly=${encodeURIComponent(yearly)}`;
            const response = await fetch(url);
            const payload = await response.json();
            if (!response.ok) {
                setStatus(payload.error || 'Failed to load payslip data.', 'danger');
                return;
            }

            if (!Array.isArray(payload.data) || !payload.data.length) {
                setStatus('No payroll rows were found for the selected filters.', 'warning');
                return;
            }

            container.innerHTML = payload.data.map((row) => renderPayslipPage(payload.company, payload.period, row, payload.yearlyTotals?.[row.PFNo] || [])).join('');
            printBtn.disabled = false;
            setStatus('Payslip preview generated successfully.', 'success');
        });

        printBtn.addEventListener('click', () => {
            html2pdf().from(container).set({
                margin: 8,
                filename: 'finance-payslip-report.pdf',
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            }).save();
        });
    </script>
</body>
</html>
