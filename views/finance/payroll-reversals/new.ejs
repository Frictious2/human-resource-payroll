<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Create Payroll Reversal Request</h2>
                    <div class="text-muted">The payroll and GL records remain unchanged until the request is fully approved and executed by Finance.</div>
                </div>
                <a href="/finance/payroll/reversals" class="btn btn-outline-secondary">Back to Reversals</a>
            </div>

            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

            <div class="row g-4">
                <div class="col-xl-5">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Posted Payroll Summary</span></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Period</dt><dd class="col-sm-7"><%= String(detail.batch.PMonth).padStart(2, '0') %>/<%= detail.batch.PYear %></dd>
                                <dt class="col-sm-5">Activity</dt><dd class="col-sm-7"><%= detail.batch.PType %></dd>
                                <dt class="col-sm-5">Workflow Status</dt><dd class="col-sm-7"><span class="badge bg-success text-white"><%= detail.batch.Status %></span></dd>
                                <dt class="col-sm-5">GL Batch</dt><dd class="col-sm-7">#<%= detail.postingBatch.id %></dd>
                                <dt class="col-sm-5">Posted By</dt><dd class="col-sm-7"><%= detail.postingBatch.posted_by || 'N/A' %></dd>
                                <dt class="col-sm-5">Posted At</dt><dd class="col-sm-7"><%= detail.postingBatch.posted_at ? new Date(detail.postingBatch.posted_at).toLocaleString('en-GB') : 'N/A' %></dd>
                                <dt class="col-sm-5">Total Staff</dt><dd class="col-sm-7"><%= Number(detail.batch.TotalStaff || 0).toLocaleString('en-US') %></dd>
                                <dt class="col-sm-5">Total Gross</dt><dd class="col-sm-7"><%= Number(detail.batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                                <dt class="col-sm-5">Total Deductions</dt><dd class="col-sm-7"><%= Number(detail.batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                                <dt class="col-sm-5">Total Net</dt><dd class="col-sm-7"><%= Number(detail.batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-xl-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Reversal Request</span></div>
                        <div class="card-body">
                            <form method="post" action="/finance/payroll/reversals">
                                <input type="hidden" name="workflowBatchId" value="<%= detail.batch.id %>" />
                                <div class="mb-3">
                                    <label class="form-label">Reason for Reversal</label>
                                    <textarea class="form-control" name="reason" rows="4" required></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Supporting Comments / Reference</label>
                                    <textarea class="form-control" name="comments" rows="4"></textarea>
                                </div>
                                <div class="form-check mb-4">
                                    <input class="form-check-input" type="checkbox" id="confirmPosted" required />
                                    <label class="form-check-label" for="confirmPosted">
                                        I confirm that this payroll batch is already posted to accounts and requires a controlled reversal workflow.
                                    </label>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-danger" type="submit"><i class="bi bi-arrow-counterclockwise me-2"></i>Create Reversal Request</button>
                                    <a class="btn btn-outline-secondary" href="/finance/payroll/reversals">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
