<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>
    <% const reversalRequest = detail && detail.reversalDetail && detail.reversalDetail.request ? detail.reversalDetail.request : {}; %>
    <% const reopenActions = detail && Array.isArray(detail.actions) ? detail.actions : []; %>
    <main class="main">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h3 mb-1">Payroll Reopen Request #<%= detail.request.id %></h1>
                    <p class="text-muted mb-0"><%= String(detail.request.PMonth).padStart(2, '0') %>/<%= detail.request.PYear %> · <%= detail.request.PType %> · Gen <%= detail.request.OriginalGenerationNo %> → Gen <%= detail.request.ProposedGenerationNo %></p>
                </div>
                <span class="badge <%= getStatusBadgeClass(detail.request.Status) %>"><%= detail.request.Status %></span>
            </div>

            <% if (successMessage) { %><div class="alert alert-success"><%= successMessage %></div><% } %>
            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

            <div class="row g-4">
                <div class="col-12 col-xl-5">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><span class="fw-semibold">Request Summary</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Reason:</strong> <%= detail.request.Reason %></div>
                            <div class="mb-2"><strong>Requested By:</strong> <%= detail.request.RequestedBy %></div>
                            <div class="mb-2"><strong>Requested At:</strong> <%= detail.request.RequestedAt ? new Date(detail.request.RequestedAt).toLocaleString('en-GB') : 'N/A' %></div>
                            <div class="mb-2"><strong>Original Checksum:</strong> <small class="text-muted"><%= detail.request.OriginalPayrollChecksum %></small></div>
                            <div class="mb-0"><strong>Original Reversal Reference:</strong> <%= detail.request.OriginalReversalReference || 'N/A' %></div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Finance Actions</span></div>
                        <div class="card-body">
                            <% if (['REQUESTED','RETURNED_BY_MANAGER','RETURNED_BY_AUDITOR'].includes(detail.request.Status)) { %>
                                <form method="post" action="/finance/payroll/reopen/<%= detail.request.id %>/submit" class="mb-3">
                                    <div class="mb-2"><label class="form-label">Submission Notes</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                                    <button type="submit" class="btn btn-primary">Submit to Manager</button>
                                </form>
                                <form method="post" action="/finance/payroll/reopen/<%= detail.request.id %>/cancel">
                                    <div class="mb-2"><label class="form-label">Cancellation Notes</label><textarea class="form-control" name="comments" rows="2"></textarea></div>
                                    <button type="submit" class="btn btn-outline-danger">Cancel Request</button>
                                </form>
                            <% } else if (detail.request.Status === 'READY_TO_REOPEN') { %>
                                <div class="alert alert-success">This reopen request has final approval and can now create a new payroll generation.</div>
                                <form method="post" action="/finance/payroll/reopen/<%= detail.request.id %>/start-reprocessing">
                                    <button type="submit" class="btn btn-primary">Start Reprocessing</button>
                                </form>
                            <% } else if (detail.request.Status === 'REOPENED') { %>
                                <div class="alert alert-info mb-0">Generation <strong><%= detail.request.ProposedGenerationNo %></strong> has been created. Continue in Process Emoluments using the same month, year, and activity.</div>
                            <% } else { %>
                                <div class="text-muted">No Finance action is available for the current reopen status.</div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-7">
                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><span class="fw-semibold">Original Batch</span></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6"><div class="text-muted small">Workflow Batch</div><div class="fw-semibold">#<%= detail.originalBatch.id %></div></div>
                                <div class="col-md-6"><div class="text-muted small">Generation</div><div class="fw-semibold"><%= detail.originalBatch.GenerationNo || 1 %></div></div>
                                <div class="col-md-6"><div class="text-muted small">Status</div><div><span class="badge bg-danger text-white"><%= detail.originalBatch.Status %></span></div></div>
                                <div class="col-md-6"><div class="text-muted small">Net</div><div class="fw-semibold"><%= Number(detail.originalBatch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-4">
                        <div class="card-header"><span class="fw-semibold">Reversal Outcome</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Reversal Request:</strong> #<%= reversalRequest.id || 'N/A' %></div>
                            <div class="mb-2"><strong>Status:</strong> <span class="badge bg-success text-white"><%= reversalRequest.Status || 'N/A' %></span></div>
                            <div class="mb-0"><strong>GL Reversal Reference:</strong> <%= reversalRequest.ReversalBatchReference || 'N/A' %></div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Reopen History</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>Action</th><th>Status</th><th>Actor</th><th>Date</th><th>Comments</th></tr></thead>
                                    <tbody>
                                        <% if (!reopenActions.length) { %><tr><td colspan="5" class="text-center text-muted py-3">No reopen actions recorded yet.</td></tr><% } %>
                                        <% reopenActions.forEach((action) => { %>
                                            <tr>
                                                <td><%= action.Action %></td>
                                                <td><small><%= action.FromStatus || 'N/A' %> → <%= action.ToStatus %></small></td>
                                                <td><%= action.ActionBy %></td>
                                                <td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : 'N/A' %></td>
                                                <td><%= action.Comments || '—' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
