<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>
    <% const reopenEligibility = eligibility || { canRequest: false, reasons: [], originalBatch: {}, reversalRequest: null, proposedGenerationNo: 'N/A' }; %>
    <main class="main">
        <div class="container-fluid py-4">
            <h1 class="h3 mb-1">Request Payroll Reopen</h1>
            <p class="text-muted mb-4">Create a controlled reopen request for a successfully reversed payroll batch.</p>

            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

            <div class="row g-4">
                <div class="col-12 col-xl-5">
                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Eligibility</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Original Batch:</strong> <%= String(reopenEligibility.originalBatch.PMonth || '').padStart(2, '0') %>/<%= reopenEligibility.originalBatch.PYear || '' %> · <%= reopenEligibility.originalBatch.PType || '' %></div>
                            <div class="mb-2"><strong>Current Status:</strong> <span class="badge <%= reopenEligibility.originalBatch.Status === 'REVERSED' ? 'bg-success text-white' : 'bg-danger text-white' %>"><%= reopenEligibility.originalBatch.Status || 'N/A' %></span></div>
                            <div class="mb-2"><strong>Original Generation:</strong> <%= reopenEligibility.originalBatch.GenerationNo || 1 %></div>
                            <div class="mb-2"><strong>Proposed New Generation:</strong> <%= reopenEligibility.proposedGenerationNo %></div>
                            <div class="mb-2"><strong>Successful Reversal:</strong> <%= reopenEligibility.reversalRequest ? `Yes (#${reopenEligibility.reversalRequest.id})` : 'No' %></div>
                            <% if (reopenEligibility.reasons.length) { %>
                                <hr>
                                <div class="fw-semibold mb-2 text-danger">Blocking Issues</div>
                                <ul class="mb-0">
                                    <% reopenEligibility.reasons.forEach((reason) => { %><li><%= reason %></li><% }) %>
                                </ul>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-7">
                    <div class="card shadow-sm">
                        <div class="card-header"><span class="fw-semibold">Reopen Request</span></div>
                        <div class="card-body">
                            <% if (!reopenEligibility.canRequest) { %>
                                <div class="alert alert-warning mb-0">This payroll batch is not currently eligible for reopening.</div>
                            <% } else { %>
                                <form method="post" action="/finance/payroll/reopen">
                                    <input type="hidden" name="workflowBatchId" value="<%= reopenEligibility.originalBatch.id %>">
                                    <div class="mb-3">
                                        <label class="form-label">Reason for Reopening</label>
                                        <textarea class="form-control" name="reason" rows="5" required placeholder="Explain the payroll error or correction required."></textarea>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Supporting Notes</label>
                                        <textarea class="form-control" name="comments" rows="4" placeholder="Optional reference, reversal notes, or operational context."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Create Reopen Request</button>
                                    <a href="/finance/payroll/reopen" class="btn btn-outline-secondary ms-2">Back</a>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
