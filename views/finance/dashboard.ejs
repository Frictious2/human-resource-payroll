<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Finance Dashboard - HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user }) %>
    <%- include('partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Finance Overview</h2>
                    <div class="text-muted">
                        Payroll workflow visibility and monthly processing readiness for <%= company.Com_Name || 'your company' %>.
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/finance/payroll/process-emoluments" class="btn btn-primary"><i class="bi bi-cpu me-2"></i>Process Emoluments</a>
                    <a href="/finance/payroll/workflow" class="btn btn-outline-primary"><i class="bi bi-diagram-3 me-2"></i>Payroll Workflow</a>
                    <a href="/finance/reports/payroll" class="btn btn-outline-secondary"><i class="bi bi-bar-chart me-2"></i>Open Reports</a>
                </div>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger shadow-sm"><%= error %></div>
            <% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-xxl-3">
                    <a href="/work-queue" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">My Work Queue</div>
                            <div class="fs-3 fw-semibold"><%= workQueueSummary.totalActionable %></div>
                            <div class="small text-muted"><%= workQueueSummary.payroll %> payroll and <%= workQueueSummary.records %> record actions waiting</div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xxl-3">
                    <a href="/notifications" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Unread Notifications</div>
                            <div class="fs-3 fw-semibold"><%= unreadNotifications %></div>
                            <div class="small text-muted">Open the notification center for recent workflow updates</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-xxl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted">Current Payroll Month</div>
                            <div class="fs-4 fw-semibold"><%= cards.currentPayrollMonth %></div>
                            <div class="small text-muted">Latest workflow or payroll period detected</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Workflow Batches</div><div class="fs-3 fw-semibold"><%= cards.processedBatches %></div></div></div>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=PROCESSED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Awaiting Submission</div><div class="fs-3 fw-semibold"><%= cards.awaitingSubmission %></div></div></a>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=SUBMITTED_TO_MANAGER" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Under Manager Review</div><div class="fs-3 fw-semibold"><%= cards.underManagerReview %></div></div></a>
                </div>
                <div class="col-6 col-md-3 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=RETURNED_BY_MANAGER" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Returned for Correction</div><div class="fs-3 fw-semibold"><%= cards.returnedForCorrection %></div></div></a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=SUBMITTED_TO_AUDITOR" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Manager Endorsed / Under Auditor Review</div><div class="fs-3 fw-semibold"><%= cards.underAuditorReview %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=RETURNED_BY_AUDITOR" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Returned after Audit Review</div><div class="fs-3 fw-semibold"><%= cards.returnedAfterAuditReview %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=SUBMITTED_TO_ENTITY_HEAD" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Auditor Endorsed / Awaiting Final Approval</div><div class="fs-3 fw-semibold"><%= cards.awaitingFinalApproval %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=FINAL_REJECTED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Rejected / Correction Required</div><div class="fs-3 fw-semibold"><%= cards.rejectedCorrectionRequired %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=CORRECTION_IN_PROGRESS" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Correction In Progress</div><div class="fs-3 fw-semibold"><%= cards.correctionInProgress %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=FINAL_APPROVED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Ready for Post to Accounts</div><div class="fs-3 fw-semibold"><%= cards.readyForPosting %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <a href="/finance/payroll/workflow?status=POSTED_TO_ACCOUNTS" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Posted</div><div class="fs-3 fw-semibold"><%= cards.alreadyPosted %></div></div></a>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Latest Staff Count</div><div class="fs-3 fw-semibold"><%= cards.totalStaffInLatestPayroll %></div></div></div>
                </div>
                <div class="col-6 col-md-4 col-xxl-2">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Returned Batches</div><div class="fs-3 fw-semibold"><%= cards.returnedBatches %></div></div></div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-6 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Latest Gross Payroll</div><div class="fs-4 fw-semibold"><%= Number(cards.latestGrossPayroll || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div>
                </div>
                <div class="col-6 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Latest Net Payroll</div><div class="fs-4 fw-semibold"><%= Number(cards.latestNetPayroll || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-6 col-md-3">
                    <a href="/finance/payroll/reversals" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Reversal Requests</div><div class="fs-3 fw-semibold"><%= Number((reversalCounts.REQUESTED || 0) + (reversalCounts.RETURNED_BY_MANAGER || 0) + (reversalCounts.RETURNED_BY_AUDITOR || 0)) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance/payroll/reversals?status=READY_TO_EXECUTE" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Ready to Execute</div><div class="fs-3 fw-semibold"><%= Number(reversalCounts.READY_TO_EXECUTE || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance/payroll/reversals?status=REVERSED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Reversed Batches</div><div class="fs-3 fw-semibold"><%= Number(reversalCounts.REVERSED || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/finance/payroll/reversals?status=REVERSAL_FAILED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Failed Reversals</div><div class="fs-3 fw-semibold"><%= Number(reversalCounts.REVERSAL_FAILED || 0) %></div></div></a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-6 col-md-4">
                    <a href="/finance/payroll/reopen" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Payroll Reopen Requests</div><div class="fs-3 fw-semibold"><%= Number((reopenCounts.REQUESTED || 0) + (reopenCounts.RETURNED_BY_MANAGER || 0) + (reopenCounts.RETURNED_BY_AUDITOR || 0)) %></div></div></a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/finance/payroll/reopen?status=READY_TO_REOPEN" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Ready to Reprocess</div><div class="fs-3 fw-semibold"><%= Number(reopenCounts.READY_TO_REOPEN || 0) %></div></div></a>
                </div>
                <div class="col-6 col-md-4">
                    <a href="/finance/payroll/reopen?status=REOPENED" class="card shadow-sm h-100 text-decoration-none text-reset"><div class="card-body"><div class="text-muted small">Reprocessed Generations</div><div class="fs-3 fw-semibold"><%= Number(reopenCounts.REOPENED || 0) %></div></div></a>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Recent Workflow Batches</span>
                            <a href="/finance/payroll/workflow" class="small text-decoration-none">Open payroll workflow</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Period</th>
                                            <th>Status</th>
                                            <th class="text-end">Staff</th>
                                            <th class="text-end">Gross</th>
                                            <th class="text-end">Net</th>
                                            <th>Updated</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (!recentBatches.length) { %>
                                            <tr><td colspan="6" class="text-center text-muted py-4">No payroll workflow batches have been created yet.</td></tr>
                                        <% } %>
                                        <% recentBatches.forEach((batch) => { %>
                                            <tr>
                                                <td class="fw-semibold"><a href="/finance/payroll/workflow/<%= batch.id %>" class="text-decoration-none"><%= String(batch.PMonth).padStart(2, '0') %>/<%= batch.PYear %> - <%= batch.PType %></a></td>
                                                <td><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></td>
                                                <td class="text-end"><%= Number(batch.TotalStaff || 0).toLocaleString() %></td>
                                                <td class="text-end"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                <td class="text-end"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                <td><%= batch.UpdatedAt ? new Date(batch.UpdatedAt).toLocaleString('en-GB') : 'N/A' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <span class="fw-semibold">Finance Actions</span>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="/finance/payroll/process-emoluments" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Run Process Emoluments</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/payroll/workflow" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Review Workflow Queue</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/payroll/yearly-payments" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Maintain Yearly Payments</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/payroll/special-payments" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Special Payments</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/payroll/post-to-accounts" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Post to Accounts</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/reports/yearly-payments" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Yearly Payments Report</span><i class="bi bi-arrow-right"></i>
                            </a>
                            <a href="/finance/reports/financial-deductions" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>Financial Deductions</span><i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="mt-4 py-3 text-center text-muted border-top">
                <%- include('partials/footer') %>
            </footer>
        </div>
    </main>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
