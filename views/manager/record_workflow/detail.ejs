<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>
    <main class="main"><div class="container-fluid py-3">
        <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1"><%= detail.item.moduleLabel %></h2><div class="text-muted"><code><%= detail.item.RecordReference %></code></div></div><a href="/manager/record-workflow" class="btn btn-outline-secondary">Back</a></div>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="card shadow-sm mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-4"><div class="text-muted small">Status</div><div><span class="badge <%= getStatusBadgeClass(detail.item.Status) %>"><%= detail.item.Status %></span></div></div><div class="col-md-4"><div class="text-muted small">Submitted By</div><div class="fw-semibold"><%= detail.item.SubmittedBy || 'N/A' %></div></div><div class="col-md-4"><div class="text-muted small">Submitted At</div><div class="fw-semibold"><%= detail.item.SubmittedAt ? new Date(detail.item.SubmittedAt).toLocaleString('en-GB') : 'N/A' %></div></div></div></div></div>
        <div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Record Details</div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead class="table-light"><tr><th>Field</th><th>Submitted Snapshot</th><th>Current Value</th></tr></thead><tbody><% detail.displayRows.forEach((row) => { %><tr><td class="fw-semibold"><%= row.field %></td><td><%= row.submittedValue ?? '-' %></td><td><%= row.currentValue ?? '-' %></td></tr><% }) %></tbody></table></div></div></div>
        <% if (detail.item.Status === 'SUBMITTED_TO_MANAGER') { %>
            <div class="row g-4 mb-4">
                <div class="col-lg-6"><div class="card shadow-sm"><div class="card-header fw-semibold">Endorse and Forward</div><div class="card-body"><form method="POST" action="/manager/record-workflow/<%= detail.item.id %>/endorse"><div class="mb-3"><label class="form-label">Manager Notes</label><textarea class="form-control" name="comments" rows="3" placeholder="Optional endorsement notes"></textarea></div><button type="submit" class="btn btn-success">Endorse to Entity Head</button></form></div></div></div>
                <div class="col-lg-6"><div class="card shadow-sm border-warning"><div class="card-header fw-semibold">Return for Correction</div><div class="card-body"><form method="POST" action="/manager/record-workflow/<%= detail.item.id %>/return"><div class="mb-3"><label class="form-label">Return Reason</label><textarea class="form-control" name="comments" rows="3" required></textarea></div><button type="submit" class="btn btn-warning">Return to Data Entry</button></form></div></div></div>
            </div>
        <% } %>
        <div class="card shadow-sm"><div class="card-header fw-semibold">Workflow History</div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Action</th><th>From</th><th>To</th><th>By</th><th>At</th><th>Comments</th></tr></thead><tbody><% if (!detail.history.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No workflow history found.</td></tr><% } %><% detail.history.forEach((row) => { %><tr><td><%= row.Action %></td><td><%= row.FromStatus || 'DRAFT' %></td><td><%= row.ToStatus %></td><td><%= row.actorName || row.ActionBy %></td><td><%= row.ActionAt ? new Date(row.ActionAt).toLocaleString('en-GB') : 'N/A' %></td><td><%= row.Comments || '-' %></td></tr><% }) %></tbody></table></div></div></div>
        <footer class="mt-4 py-3 text-center text-muted border-top"><%- include('../partials/footer') %></footer>
    </div></main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
