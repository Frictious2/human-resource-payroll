<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>
    <main class="main">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div><h2 class="mb-1">Payroll Reversal Review</h2><div class="text-muted">Manager review of the Finance reversal request and original posted payroll.</div></div>
                <a href="/manager/payroll/reversals" class="btn btn-outline-secondary">Back to Queue</a>
            </div>
            <% if (successMessage) { %><div class="alert alert-success"><%= successMessage %></div><% } %>
            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
            <div class="row g-4 mb-4">
                <div class="col-xl-5">
                    <div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Request Summary</span></div><div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge <%= detail.request.badgeClass %>"><%= detail.request.Status %></span></dd>
                            <dt class="col-sm-5">Period</dt><dd class="col-sm-7"><%= String(detail.request.PMonth).padStart(2, '0') %>/<%= detail.request.PYear %></dd>
                            <dt class="col-sm-5">Activity</dt><dd class="col-sm-7"><%= detail.request.PType %></dd>
                            <dt class="col-sm-5">GL Batch</dt><dd class="col-sm-7">#<%= detail.request.GLPostingBatchID %></dd>
                            <dt class="col-sm-5">Reason</dt><dd class="col-sm-7"><%= detail.request.Reason %></dd>
                            <dt class="col-sm-5">Requested At</dt><dd class="col-sm-7"><%= detail.request.RequestedAt ? new Date(detail.request.RequestedAt).toLocaleString('en-GB') : 'N/A' %></dd>
                        </dl>
                    </div></div>
                </div>
                <div class="col-xl-7">
                    <div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Manager Actions</span></div><div class="card-body">
                        <% if (detail.request.Status === 'SUBMITTED_TO_MANAGER') { %>
                            <form method="post" action="/manager/payroll/reversals/<%= detail.request.id %>/endorse" class="mb-4">
                                <div class="mb-3"><label class="form-label">Endorsement Comment (optional)</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                                <button class="btn btn-success" type="submit">Endorse and Forward to Auditor</button>
                            </form>
                            <form method="post" action="/manager/payroll/reversals/<%= detail.request.id %>/return">
                                <div class="mb-3"><label class="form-label">Return Comment</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                                <button class="btn btn-warning" type="submit">Return to Finance</button>
                            </form>
                        <% } else { %>
                            <div class="text-muted">This reversal request is no longer awaiting Manager endorsement.</div>
                        <% } %>
                    </div></div>
                </div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-xl-6"><div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Payroll Totals</span></div><div class="card-body"><dl class="row mb-0">
                    <dt class="col-sm-6">Total Staff</dt><dd class="col-sm-6"><%= Number(detail.workflowDetail.batch.TotalStaff || 0).toLocaleString('en-US') %></dd>
                    <dt class="col-sm-6">Total Gross</dt><dd class="col-sm-6"><%= Number(detail.workflowDetail.batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                    <dt class="col-sm-6">Total Deductions</dt><dd class="col-sm-6"><%= Number(detail.workflowDetail.batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                    <dt class="col-sm-6">Total Net</dt><dd class="col-sm-6"><%= Number(detail.workflowDetail.batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                </dl></div></div></div>
                <div class="col-xl-6"><div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">GL Posting Summary</span></div><div class="card-body"><dl class="row mb-0">
                    <dt class="col-sm-6">Posting Status</dt><dd class="col-sm-6"><%= detail.postingDetail?.batch?.status || 'N/A' %></dd>
                    <dt class="col-sm-6">Posted By</dt><dd class="col-sm-6"><%= detail.postingDetail?.batch?.posted_by || 'N/A' %></dd>
                    <dt class="col-sm-6">Posted At</dt><dd class="col-sm-6"><%= detail.postingDetail?.batch?.posted_at ? new Date(detail.postingDetail.batch.posted_at).toLocaleString('en-GB') : 'N/A' %></dd>
                    <dt class="col-sm-6">GL Total Amount</dt><dd class="col-sm-6"><%= Number(detail.postingDetail?.batch?.total_amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></dd>
                </dl></div></div></div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header"><span class="fw-semibold">Workflow History</span></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Action</th><th>From</th><th>To</th><th>Comments</th><th>When</th></tr></thead>
                            <tbody>
                                <% if (!detail.actions.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No reversal workflow history recorded yet.</td></tr><% } %>
                                <% detail.actions.forEach((action) => { %><tr><td><%= action.Action %></td><td><%= action.FromStatus || 'N/A' %></td><td><%= action.ToStatus %></td><td><%= action.Comments || '—' %></td><td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : 'N/A' %></td></tr><% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
