<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= workspaceLabel %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../' + partialsBase + '/topbar', { user }) %>
    <%- include('../' + partialsBase + '/sidebar') %>
    <main class="main">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h3 mb-1"><%= title %></h1>
                    <p class="text-muted mb-0"><%= detail.paymentTypeMeta.label %> · <%= detail.batch.PaymentYear %> · batch #<%= detail.batch.id %></p>
                </div>
                <span class="badge <%= getStatusBadgeClass(detail.batch.Status) %>"><%= detail.batch.Status %></span>
            </div>

            <% if (successMessage) { %><div class="alert alert-success"><%= successMessage %></div><% } %>
            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Batch Summary</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Payment Date:</strong> <%= detail.batch.PaymentDate ? new Date(detail.batch.PaymentDate).toLocaleDateString('en-GB') : '-' %></div>
                            <div class="mb-2"><strong>Total Staff:</strong> <%= Number(detail.batch.TotalStaff || 0).toLocaleString() %></div>
                            <div class="mb-2"><strong>Total Amount:</strong> <%= Number(detail.batch.TotalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                            <div class="mb-2"><strong>Prepared By:</strong> <%= detail.batch.PreparedBy %></div>
                            <div class="mb-2"><strong>Prepared At:</strong> <%= detail.batch.PreparedAt ? new Date(detail.batch.PreparedAt).toLocaleString('en-GB') : '-' %></div>
                            <div class="mb-0"><strong>Snapshot Checksum:</strong> <small class="text-muted"><%= detail.batch.SnapshotChecksum %></small></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Loan Parameter Snapshot</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Advance Interest:</strong> <%= Number(detail.loanParams?.AdvanceInt || 0).toLocaleString() %>%</div>
                            <div class="mb-0"><strong>Loan Duration Threshold:</strong> <%= Number(detail.loanParams?.LoanDuration || 0).toLocaleString() %></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Workflow Actions</span></div>
                        <div class="card-body">
                            <% if (workspaceRole === 'finance-officer' && ['DRAFT','CALCULATED','RETURNED_BY_MANAGER','RETURNED_BY_AUDITOR'].includes(detail.batch.Status)) { %>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/submit">
                                    <div class="mb-3">
                                        <label class="form-label">Submission Notes</label>
                                        <textarea class="form-control" name="comments" rows="3"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Submit to Manager</button>
                                </form>
                            <% } else if (workspaceRole === 'manager' && detail.batch.Status === 'SUBMITTED_TO_MANAGER') { %>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/endorse" class="mb-3">
                                    <div class="mb-3"><label class="form-label">Endorsement Notes</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                                    <button type="submit" class="btn btn-primary">Endorse and Forward</button>
                                </form>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/return">
                                    <div class="mb-3"><label class="form-label">Return Comments</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                                    <button type="submit" class="btn btn-outline-warning">Return to Finance</button>
                                </form>
                            <% } else if (workspaceRole === 'auditor' && detail.batch.Status === 'SUBMITTED_TO_AUDITOR') { %>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/endorse" class="mb-3">
                                    <div class="mb-3"><label class="form-label">Audit Notes</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                                    <button type="submit" class="btn btn-primary">Endorse and Forward</button>
                                </form>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/return">
                                    <div class="mb-3"><label class="form-label">Return Findings</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                                    <button type="submit" class="btn btn-outline-warning">Return to Finance</button>
                                </form>
                            <% } else if (workspaceRole === 'entity-head' && detail.batch.Status === 'SUBMITTED_TO_ENTITY_HEAD') { %>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/approve" class="mb-3">
                                    <div class="mb-3"><label class="form-label">Approval Comments</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                                    <button type="submit" class="btn btn-success">Final Approve and Apply</button>
                                </form>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/return" class="mb-3">
                                    <div class="mb-3"><label class="form-label">Return Comments</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                                    <button type="submit" class="btn btn-outline-warning">Return to Finance</button>
                                </form>
                                <form method="post" action="<%= actionBasePath %>/<%= detail.batch.id %>/reject">
                                    <div class="mb-3"><label class="form-label">Rejection Reason</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                                    <button type="submit" class="btn btn-outline-danger">Reject Batch</button>
                                </form>
                            <% } else { %>
                                <div class="text-muted">No direct action is available for the current status in this workspace.</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header"><span class="fw-semibold">Batch Rows</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>PFNo</th>
                                <th>Name</th>
                                <th>Dept</th>
                                <th>Grade</th>
                                <th>DOE</th>
                                <th class="text-end">Base Salary</th>
                                <th class="text-end">Monthly</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Net</th>
                                <th>Status</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!detail.rows.length) { %>
                                <tr><td colspan="12" class="text-center text-muted py-4">No batch rows were calculated.</td></tr>
                            <% } %>
                            <% detail.rows.forEach((row) => { %>
                                <tr>
                                    <td><%= row.PFNo %></td>
                                    <td><%= row.StaffName %></td>
                                    <td><%= row.DepartmentName || row.DepartmentCode || '-' %></td>
                                    <td><%= row.GradeName || row.GradeCode || '-' %></td>
                                    <td><%= row.DateOfEmployment ? new Date(row.DateOfEmployment).toLocaleDateString('en-GB') : '-' %></td>
                                    <td class="text-end"><%= Number(row.BaseSalary || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.MonthlyAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.TotalIncome || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.TaxAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td class="text-end"><%= Number(row.NetIncome || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td>
                                        <span class="badge <%= row.EligibilityStatus === 'ELIGIBLE' ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : 'bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle' %>"><%= row.EligibilityStatus %></span>
                                        <% if (Number(row.FirstYearRentReduction || 0) === 1) { %>
                                            <div class="small text-muted">First-year rent reduced to 6 months</div>
                                        <% } %>
                                    </td>
                                    <td class="small text-muted"><%= row.EligibilityReason || row.CalculationBasis || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header"><span class="fw-semibold">Workflow History</span></div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>When</th>
                                <th>Action</th>
                                <th>From</th>
                                <th>To</th>
                                <th>By</th>
                                <th>Comments</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!detail.actions.length) { %>
                                <tr><td colspan="6" class="text-center text-muted py-4">No workflow history is available yet.</td></tr>
                            <% } %>
                            <% detail.actions.forEach((action) => { %>
                                <tr>
                                    <td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : '-' %></td>
                                    <td><%= action.Action %></td>
                                    <td><%= action.FromStatus || '-' %></td>
                                    <td><%= action.ToStatus %></td>
                                    <td><%= action.ActionBy %></td>
                                    <td><%= action.Comments || '-' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
