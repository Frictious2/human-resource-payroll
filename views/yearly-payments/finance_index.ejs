<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= workspaceLabel %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../' + partialsBase + '/topbar', { user }) %>
    <%- include('../' + partialsBase + '/sidebar') %>

    <main class="main">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h3 mb-1"><%= title %></h1>
                    <p class="text-muted mb-0">Prepare annual Rent, Inducement, and Leave payment batches without changing live <code>tblyearlypayments</code> rows until final Entity Head approval.</p>
                </div>
            </div>

            <% if (successMessage) { %><div class="alert alert-success"><%= successMessage %></div><% } %>
            <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold"><%= workspaceRole === 'finance-manager' ? 'Yearly Payment Oversight' : 'Prepare Annual Batch' %></span></div>
                        <div class="card-body">
                            <% if (workspaceRole === 'finance-officer') { %>
                                <form method="post" action="/finance/payroll/yearly-payments/preview" class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Payment Year</label>
                                        <input type="number" min="2000" max="2100" class="form-control" name="paymentYear" value="<%= pageData.filters.paymentYear %>" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Payment Type</label>
                                        <select class="form-select" name="paymentType" required>
                                            <option value="">Select yearly payment type</option>
                                            <% pageData.supportedTypes.forEach((item) => { %>
                                                <option value="<%= item.code %>"><%= item.label %> (<%= item.code %>)</option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Payment Date</label>
                                        <input type="date" class="form-control" name="paymentDate" value="<%= `${pageData.filters.paymentYear}-12-31` %>" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Reason / Notes</label>
                                        <textarea class="form-control" name="reason" rows="3" placeholder="State why this annual batch is being prepared." required></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-calculator me-2"></i>Preview and Save Draft
                                        </button>
                                    </div>
                                </form>
                            <% } else { %>
                                <div class="text-muted">
                                    Finance Manager has read-only visibility into yearly Rent, Inducement, and Leave batches. Preparation, submission, endorsement, and approval remain limited to the operational workflow roles.
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Loan Global Parameters</span></div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Interest:</strong> <%= Number(pageData.loanParams?.AdvanceInt || 0).toLocaleString() %>%</div>
                            <div class="mb-2"><strong>Loan Duration Threshold:</strong> <%= Number(pageData.loanParams?.LoanDuration || 0).toLocaleString() %></div>
                            <div class="small text-muted">
                                These values come from <code>tblparams1</code>. New loan drafts should use the currently approved values, while existing approved loans keep the stored historical values already recorded on each loan row.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Payroll Item Semantics</span></div>
                        <div class="card-body">
                            <div class="small text-muted mb-2">Confirmed yearly items from <code>tblpayrollitems</code>:</div>
                            <ul class="small mb-0">
                                <% (pageData.payrollItemFieldMap || []).filter((item) => ['02','05','13'].includes(item.code)).forEach((item) => { %>
                                    <li><strong><%= item.code %> <%= item.income %></strong> uses <code>Freq = Y</code> and stays out of ordinary monthly payroll until an annual batch is approved.</li>
                                <% }) %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Yearly Payment Batches</span>
                    <span class="badge text-bg-secondary"><%= pageData.batches.length %> total</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Year</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-end">Staff</th>
                                <th class="text-end">Total Amount</th>
                                <th>Prepared By</th>
                                <th>Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!pageData.batches.length) { %>
                                <tr><td colspan="8" class="text-center text-muted py-4">No yearly payment batches have been prepared yet.</td></tr>
                            <% } %>
                            <% pageData.batches.forEach((row) => { %>
                                <tr>
                                    <td><%= row.PaymentYear %></td>
                                    <td><%= row.PaymentTypeName || row.PaymentType %></td>
                                    <td><span class="badge <%= row.Status === 'APPLIED' ? 'bg-success-subtle text-success-emphasis border border-success-subtle' : row.Status.includes('RETURNED') ? 'bg-warning-subtle text-warning-emphasis border border-warning-subtle' : 'bg-info-subtle text-info-emphasis border border-info-subtle' %>"><%= row.Status %></span></td>
                                    <td class="text-end"><%= Number(row.TotalStaff || 0).toLocaleString() %></td>
                                    <td class="text-end"><%= Number(row.TotalAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                    <td><%= row.PreparedBy %></td>
                                    <td><%= row.UpdatedAt ? new Date(row.UpdatedAt).toLocaleString('en-GB') : '-' %></td>
                                    <td class="text-end"><a href="/finance/payroll/yearly-payments/<%= row.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
