<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entity Reports · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user, entityScope }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid">
            <div class="mb-4"><h2 class="mb-1">Entity Reports</h2><div class="text-muted">Read-only summary reporting for <strong><%= entityScope.scopeLabel || entityScope.deptName %></strong>.</div></div>
            <div class="row g-4 mb-4">
                <div class="col-md-6 col-xxl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Active Staff</div><div class="fs-3 fw-semibold"><%= cards.activeStaff %></div></div></div></div>
                <div class="col-md-6 col-xxl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">On Leave</div><div class="fs-3 fw-semibold"><%= cards.onLeaveNow %></div></div></div></div>
                <div class="col-md-6 col-xxl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Attendance Rows</div><div class="fs-3 fw-semibold"><%= attendanceTotals.TotalRows || 0 %></div></div></div></div>
                <div class="col-md-6 col-xxl-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Training Rows</div><div class="fs-3 fw-semibold"><%= trainingTotals.TotalRows || 0 %></div></div></div></div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center"><span class="fw-semibold">Quick Links</span></div>
                        <div class="list-group list-group-flush">
                            <a class="list-group-item list-group-item-action" href="/entity-head/staff">Staff overview</a>
                            <a class="list-group-item list-group-item-action" href="/entity-head/attendance">Attendance summary</a>
                            <a class="list-group-item list-group-item-action" href="/entity-head/leave">Leave summary</a>
                            <a class="list-group-item list-group-item-action" href="/entity-head/transfers">Transfer / promotion summary</a>
                            <a class="list-group-item list-group-item-action" href="/entity-head/training">Training summary</a>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Report Totals</span></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-6"><div class="border rounded p-3"><div class="text-muted small">Staff Rows</div><div class="fs-4 fw-semibold"><%= staffCount %></div></div></div>
                                <div class="col-6"><div class="border rounded p-3"><div class="text-muted small">Approved Attendance</div><div class="fs-4 fw-semibold"><%= attendanceTotals.ApprovedRows || 0 %></div></div></div>
                                <div class="col-6"><div class="border rounded p-3"><div class="text-muted small">Current Leave</div><div class="fs-4 fw-semibold"><%= leaveTotals.CurrentLeave || 0 %></div></div></div>
                                <div class="col-6"><div class="border rounded p-3"><div class="text-muted small">Completed Training</div><div class="fs-4 fw-semibold"><%= trainingTotals.CompletedRows || 0 %></div></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header"><span class="fw-semibold">Recent Transfer / Promotion Activity</span></div>
                <div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Type</th><th>PF No</th><th>Staff</th><th>Date</th><th>From</th><th>To</th></tr></thead>
                    <tbody>
                        <% if (!transferRows.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No scoped transfer or promotion rows found.</td></tr><% } %>
                        <% transferRows.forEach((row) => { %><tr><td><%= row.RecordType %></td><td class="fw-semibold"><%= row.PFNo %></td><td><%= row.SName %></td><td><%= row.EffectiveDate ? new Date(row.EffectiveDate).toLocaleDateString('en-GB') : 'N/A' %></td><td><%= row.PreviousValue || 'N/A' %></td><td><%= row.NewValue || 'N/A' %></td></tr><% }) %>
                    </tbody>
                </table></div></div>
            </div>

            <footer class="mt-4 py-3 text-center text-muted border-top"><%- include('partials/footer') %></footer>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
