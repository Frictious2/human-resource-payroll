<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user, entityScope }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1"><%= detail.request.moduleLabel %> Final Approval</h2>
                    <div class="text-muted">Compare the live values against the proposed values before applying any change to the source table.</div>
                </div>
                <a href="/entity-head/parameter-changes" class="btn btn-outline-secondary">Back to queue</a>
            </div>

            <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Request Summary</span></div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Module</dt><dd class="col-sm-7"><%= detail.request.moduleLabel %></dd>
                                <dt class="col-sm-5">Change Type</dt><dd class="col-sm-7"><%= detail.request.ChangeType %></dd>
                                <dt class="col-sm-5">Source Table</dt><dd class="col-sm-7"><code><%= detail.request.SourceTable %></code></dd>
                                <dt class="col-sm-5">Reference</dt><dd class="col-sm-7"><code><%= detail.request.RecordReference %></code></dd>
                                <dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge <%= detail.request.badgeClass %>"><%= detail.request.Status %></span></dd>
                                <dt class="col-sm-5">Reason</dt><dd class="col-sm-7"><%= detail.request.Reason %></dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-8">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Approval Actions</span></div>
                        <div class="card-body">
                            <% if (detail.request.Status === 'SUBMITTED_TO_ENTITY_HEAD') { %>
                                <form method="post" action="/entity-head/parameter-changes/<%= detail.request.id %>/approve" class="mb-4">
                                    <div class="mb-3">
                                        <label class="form-label">Approval Comment (optional)</label>
                                        <textarea class="form-control" name="comments" rows="3"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-success">Approve and Apply Change</button>
                                </form>
                                <form method="post" action="/entity-head/parameter-changes/<%= detail.request.id %>/return" class="mb-4">
                                    <div class="mb-3">
                                        <label class="form-label">Return Comment</label>
                                        <textarea class="form-control" name="comments" rows="3" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-warning">Return for Correction</button>
                                </form>
                                <form method="post" action="/entity-head/parameter-changes/<%= detail.request.id %>/reject">
                                    <div class="mb-3">
                                        <label class="form-label">Rejection Reason</label>
                                        <textarea class="form-control" name="comments" rows="3" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-danger">Reject Change</button>
                                </form>
                            <% } else { %>
                                <div class="text-muted">This request is no longer awaiting Entity Head/HNO action.</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header"><span class="fw-semibold">Old vs Proposed Values</span></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Field</th><th>Current Live Value</th><th>Proposed Value</th></tr></thead>
                            <tbody>
                                <% if (!detail.comparisonRows.length) { %>
                                    <tr><td colspan="3" class="text-center text-muted py-4">No field-level values are stored for this request.</td></tr>
                                <% } %>
                                <% detail.comparisonRows.forEach((row) => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= row.field %></td>
                                        <td><code><%= row.oldValue === null || row.oldValue === undefined ? '' : JSON.stringify(row.oldValue) %></code></td>
                                        <td><code><%= row.proposedValue === null || row.proposedValue === undefined ? '' : JSON.stringify(row.proposedValue) %></code></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <% if (detail.usageSummary) { %>
                <div class="card shadow-sm mb-4">
                    <div class="card-header"><span class="fw-semibold">Historical Usage Summary</span></div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Payroll Rows</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.tblPayroll || 0 %></div></div></div>
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Yearly Payments</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.tblyearlypayments || 0 %></div></div></div>
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Increment Records</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.tblincrement || 0 %></div></div></div>
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Workflow Batches</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.payroll_workflow_batches || 0 %></div></div></div>
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">GL Posting Batches</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.payroll_gl_posting_batches || 0 %></div></div></div>
                            <div class="col-md-4"><div class="border rounded p-3 h-100"><div class="text-muted small">Export History</div><div class="fs-5 fw-semibold"><%= detail.usageSummary.tblexport || 0 %></div></div></div>
                        </div>
                        <div class="alert alert-warning mt-3 mb-0">
                            <% if (detail.usageSummary.hasHistoricalUsage) { %>
                                This activity code already has historical usage. Approval should preserve reporting continuity, and deletion is blocked.
                            <% } else { %>
                                No historical usage was found for this activity code at the time this proposal was loaded.
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <div class="card shadow-sm">
                <div class="card-header"><span class="fw-semibold">Workflow History</span></div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Action</th><th>From</th><th>To</th><th>Comments</th><th>When</th></tr></thead>
                            <tbody>
                                <% if (!detail.actions.length) { %>
                                    <tr><td colspan="5" class="text-center text-muted py-4">No action history recorded yet.</td></tr>
                                <% } %>
                                <% detail.actions.forEach((action) => { %>
                                    <tr>
                                        <td><%= action.Action %></td>
                                        <td><%= action.FromStatus || 'N/A' %></td>
                                        <td><%= action.ToStatus %></td>
                                        <td><%= action.Comments || '—' %></td>
                                        <td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
