<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entity Staff Overview · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user, entityScope }) %>
    <%- include('partials/sidebar') %>
    <main class="main">
        <div class="container-fluid">
            <div class="mb-4">
                <h2 class="mb-1">Staff Overview</h2>
                <div class="text-muted">Read-only staff list for <strong><%= entityScope.scopeLabel || entityScope.deptName %></strong>.</div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form class="row g-3" method="get" action="/entity-head/staff">
                        <div class="col-md-4"><label class="form-label">PF No</label><input class="form-control" name="pfNo" value="<%= filters.pfNo %>"></div>
                        <div class="col-md-4"><label class="form-label">Staff Name</label><input class="form-control" name="staffName" value="<%= filters.staffName %>"></div>
                        <div class="col-md-4 d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Filter</button><a class="btn btn-outline-secondary" href="/entity-head/staff">Reset</a></div>
                    </form>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>PF No</th><th>Staff</th><th>Department</th><th>Grade</th><th>Job Title</th><th>Date Employed</th><th>Phone</th></tr></thead>
                            <tbody>
                                <% if (!rows.length) { %><tr><td colspan="7" class="text-center text-muted py-4">No staff records matched the current filter.</td></tr><% } %>
                                <% rows.forEach((row) => { %>
                                    <tr>
                                        <td class="fw-semibold"><%= row.PFNo %></td>
                                        <td><div class="fw-semibold"><%= row.SName %></div><div class="small text-muted"><%= row.Email || 'No email' %></div></td>
                                        <td><%= row.DeptName || 'N/A' %></td>
                                        <td><%= row.Grade || 'N/A' %></td>
                                        <td><%= row.JobTitle || 'N/A' %></td>
                                        <td><%= row.DOE ? new Date(row.DOE).toLocaleDateString('en-GB') : 'N/A' %></td>
                                        <td><%= row.Phone || 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <% if (pagination && pagination.totalPages > 1) { %>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-3">
                    <div class="text-muted small">Showing page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalRows %> records)</div>
                    <nav aria-label="Staff pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item <%= pagination.hasPrevious ? '' : 'disabled' %>">
                                <a class="page-link" href="?pfNo=<%= encodeURIComponent(filters.pfNo || '') %>&staffName=<%= encodeURIComponent(filters.staffName || '') %>&page=<%= pagination.previousPage %>&pageSize=<%= pagination.pageSize %>">Previous</a>
                            </li>
                            <li class="page-item disabled"><span class="page-link"><%= pagination.page %> / <%= pagination.totalPages %></span></li>
                            <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
                                <a class="page-link" href="?pfNo=<%= encodeURIComponent(filters.pfNo || '') %>&staffName=<%= encodeURIComponent(filters.staffName || '') %>&page=<%= pagination.nextPage %>&pageSize=<%= pagination.pageSize %>">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            <% } %>
            <footer class="mt-4 py-3 text-center text-muted border-top"><%- include('partials/footer') %></footer>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
