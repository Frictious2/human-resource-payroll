<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Entity Head</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user, entityScope }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Final Payroll Approval Queue</h2>
                    <p class="text-muted mb-0">Read-only payroll review queue for Entity Head/HNO final decisions.</p>
                </div>
                <a href="/entity-head/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
            </div>

            <% if (successMessage) { %><div class="alert alert-success shadow-sm"><%= successMessage %></div><% } %>
            <% if (errorMessage) { %><div class="alert alert-danger shadow-sm"><%= errorMessage %></div><% } %>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form method="GET" action="/entity-head/payroll/approvals" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status">
                                <% statusOptions.forEach((status) => { %>
                                    <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Month</label>
                            <input class="form-control" type="number" min="1" max="12" name="month" value="<%= filters.month %>" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Year</label>
                            <input class="form-control" type="number" min="2000" max="2100" name="year" value="<%= filters.year %>" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Activity</label>
                            <input class="form-control" type="text" name="pType" value="<%= filters.pType %>" />
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-2"></i>Filter Queue</button>
                            <a href="/entity-head/payroll/approvals" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Payroll Batches</span>
                    <span class="small text-muted"><%= batches.length %> batch(es)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Month</th>
                                    <th>Year</th>
                                    <th>Activity</th>
                                    <th>Total Staff</th>
                                    <th class="text-end">Total Gross</th>
                                    <th class="text-end">Total Tax</th>
                                    <th class="text-end">Total Deductions</th>
                                    <th class="text-end">Total Net</th>
                                    <th>Auditor Endorsed By</th>
                                    <th>Auditor Endorsed At</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!batches.length) { %>
                                    <tr><td colspan="12" class="text-center text-muted py-4">No payroll batches matched the selected filters.</td></tr>
                                <% } %>
                                <% batches.forEach((batch) => { %>
                                    <tr>
                                        <td><%= String(batch.PMonth).padStart(2, '0') %></td>
                                        <td><%= batch.PYear %></td>
                                        <td><%= batch.PType %></td>
                                        <td><%= Number(batch.TotalStaff || 0).toLocaleString() %></td>
                                        <td class="text-end"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(batch.TotalTax || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td><%= batch.auditorEndorsedByName || batch.AuditorEndorsedBy || 'N/A' %></td>
                                        <td><%= batch.AuditorEndorsedAt ? new Date(batch.AuditorEndorsedAt).toLocaleString('en-GB') : 'N/A' %></td>
                                        <td><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></td>
                                        <td class="text-end"><a href="/entity-head/payroll/approvals/<%= batch.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <footer class="mt-4 py-3 text-center text-muted border-top">
                <%- include('../partials/footer') %>
            </footer>
        </div>
    </main>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
