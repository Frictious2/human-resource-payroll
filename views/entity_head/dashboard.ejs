<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Entity Head Dashboard · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('partials/topbar', { user, entityScope }) %>
    <%- include('partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Entity Head Overview</h2>
                    <div class="text-muted">Read-only view for <strong><%= entityScope.scopeLabel || entityScope.deptName %></strong>.</div>
                </div>
                <div class="text-muted small">All data on this dashboard is organization-wide and read-only.</div>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger shadow-sm"><%= error %></div>
            <% } %>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-xl-3">
                    <a href="/work-queue" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">My Work Queue</div>
                            <div class="fs-3 fw-semibold"><%= workQueueSummary.totalActionable %></div>
                            <div class="small text-muted"><%= workQueueSummary.payroll %> payroll and <%= workQueueSummary.records %> record approvals waiting</div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <a href="/notifications" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Unread Notifications</div>
                            <div class="fs-3 fw-semibold"><%= unreadNotifications %></div>
                            <div class="small text-muted">Recent final-approval workflow activity</div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <a href="/entity-head/parameter-changes" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Parameter Changes Awaiting Approval</div>
                            <div class="fs-3 fw-semibold"><%= parameterChangeCounts.SUBMITTED_TO_ENTITY_HEAD || 0 %></div>
                            <div class="small text-muted"><%= parameterChangeCounts.APPLIED || 0 %> parameter changes already applied</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Sensitive Record Final Approval Workflow</span>
                            <a href="/entity-head/record-workflow" class="small text-decoration-none">Open record approval queue</a>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-3 col-xl">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-muted small">Awaiting Final Approval</div>
                                        <div class="fs-4 fw-semibold"><%= recordWorkflow.counts.SUBMITTED_TO_ENTITY_HEAD || 0 %></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3 col-xl">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-muted small">Approved Records</div>
                                        <div class="fs-4 fw-semibold"><%= recordWorkflow.counts.FINAL_APPROVED || 0 %></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3 col-xl">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-muted small">Returned Records</div>
                                        <div class="fs-4 fw-semibold"><%= recordWorkflow.counts.RETURNED_BY_ENTITY_HEAD || 0 %></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3 col-xl">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-muted small">Rejected Records</div>
                                        <div class="fs-4 fw-semibold"><%= recordWorkflow.counts.FINAL_REJECTED || 0 %></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-3 col-xl">
                                    <div class="border rounded p-3 h-100">
                                        <div class="text-muted small">Recent Final Decisions</div>
                                        <div class="fs-4 fw-semibold"><%= (recordWorkflow.recent || []).length %></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/entity-head/payroll/approvals" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Payroll Awaiting Final Approval</div>
                            <div class="fs-3 fw-semibold"><%= payrollCards.awaitingFinalApproval %></div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/entity-head/payroll/approvals?status=FINAL_APPROVED" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Final Approved Payroll</div>
                            <div class="fs-3 fw-semibold"><%= payrollCards.finalApproved %></div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/entity-head/payroll/approvals?status=FINAL_REJECTED" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Returned / Rejected Payroll</div>
                            <div class="fs-3 fw-semibold"><%= payrollCards.finalRejected %></div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/entity-head/payroll/reversals" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Reversals Awaiting Final Approval</div>
                            <div class="fs-3 fw-semibold"><%= Number(reversalCounts.SUBMITTED_TO_ENTITY_HEAD || 0) %></div>
                        </div>
                    </a>
                </div>
                <div class="col-12 col-md-4">
                    <a href="/entity-head/payroll/reopen" class="card shadow-sm h-100 text-decoration-none text-reset">
                        <div class="card-body">
                            <div class="text-muted">Reopen Requests Awaiting Final Approval</div>
                            <div class="fs-3 fw-semibold"><%= Number(reopenCounts.SUBMITTED_TO_ENTITY_HEAD || 0) %></div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Recent Final Approval Actions</span>
                            <a href="/entity-head/payroll/approvals" class="small text-decoration-none">Open payroll queue</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th>Action</th><th>Period</th><th>Status</th><th>By</th><th>Date</th></tr>
                                    </thead>
                                    <tbody>
                                        <% if (!payrollRecentActions.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No payroll approval actions have been recorded yet.</td></tr><% } %>
                                        <% payrollRecentActions.forEach((row) => { %>
                                            <tr>
                                                <td><%= row.Action %></td>
                                                <td><%= String(row.PMonth).padStart(2, '0') %>/<%= row.PYear %> · <%= row.PType %></td>
                                                <td><span class="badge bg-light text-dark border"><%= row.ToStatus %></span></td>
                                                <td><%= row.actorName || row.actorRole || 'N/A' %></td>
                                                <td><%= row.ActionAt ? new Date(row.ActionAt).toLocaleString('en-GB') : 'N/A' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-5">
                    <div class="card shadow-sm h-100">
                        <div class="card-header">
                            <span class="fw-semibold">Latest Payroll Awaiting Approval</span>
                        </div>
                        <div class="card-body">
                            <% if (!latestAwaitingPayroll) { %>
                                <div class="text-muted">There is no payroll batch currently awaiting final approval.</div>
                            <% } else { %>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="text-muted small">Period</div>
                                        <div class="fw-semibold"><%= String(latestAwaitingPayroll.PMonth).padStart(2, '0') %>/<%= latestAwaitingPayroll.PYear %></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small">Activity</div>
                                        <div class="fw-semibold"><%= latestAwaitingPayroll.PType %></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small">Total Staff</div>
                                        <div class="fw-semibold"><%= Number(latestAwaitingPayroll.TotalStaff || 0).toLocaleString() %></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small">Total Gross</div>
                                        <div class="fw-semibold"><%= Number(latestAwaitingPayroll.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="text-muted small">Total Net</div>
                                        <div class="fw-semibold"><%= Number(latestAwaitingPayroll.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Active Staff</div><div class="fs-3 fw-semibold"><%= cards.activeStaff %></div></div></div>
                </div>
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">On Leave Now</div><div class="fs-3 fw-semibold"><%= cards.onLeaveNow %></div></div></div>
                </div>
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Attendance Rows (30 Days)</div><div class="fs-3 fw-semibold"><%= cards.attendanceLast30Days %></div></div></div>
                </div>
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Training (12 Months)</div><div class="fs-3 fw-semibold"><%= cards.trainingLast12Months %></div></div></div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Current Leave</span>
                            <a href="/entity-head/leave" class="small text-decoration-none">Open leave summary</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light"><tr><th>PF No</th><th>Staff</th><th>Type</th><th>Resumption</th></tr></thead>
                                    <tbody>
                                        <% if (!currentLeaveRows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No staff are currently on leave in this view.</td></tr><% } %>
                                        <% currentLeaveRows.forEach((row) => { %>
                                            <tr>
                                                <td class="fw-semibold"><%= row.PFNO %></td>
                                                <td><%= row.SName %></td>
                                                <td><%= row.LeaveType || 'N/A' %></td>
                                                <td><%= row.ResumptionDate ? new Date(row.ResumptionDate).toLocaleDateString('en-GB') : 'N/A' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Recent Training</span>
                            <a href="/entity-head/training" class="small text-decoration-none">Open training summary</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light"><tr><th>PF No</th><th>Staff</th><th>Course</th><th>Date</th></tr></thead>
                                    <tbody>
                                        <% if (!recentTrainingRows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No training records found for this view.</td></tr><% } %>
                                        <% recentTrainingRows.forEach((row) => { %>
                                            <tr>
                                                <td class="fw-semibold"><%= row.PFNo %></td>
                                                <td><%= row.SName %></td>
                                                <td><%= row.Course || row.TypeName || 'N/A' %></td>
                                                <td><%= row.StartDate ? new Date(row.StartDate).toLocaleDateString('en-GB') : 'N/A' %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Recent Transfers / Promotions</span>
                    <a href="/entity-head/transfers" class="small text-decoration-none">Open summary</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>Type</th><th>PF No</th><th>Staff</th><th>Date</th><th>From</th><th>To</th></tr></thead>
                            <tbody>
                                <% if (!recentTransferRows.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No transfer or promotion records found for this view.</td></tr><% } %>
                                <% recentTransferRows.forEach((row) => { %>
                                    <tr>
                                        <td><span class="badge text-bg-light"><%= row.RecordType %></span></td>
                                        <td class="fw-semibold"><%= row.PFNo %></td>
                                        <td><%= row.SName %></td>
                                        <td><%= row.EffectiveDate ? new Date(row.EffectiveDate).toLocaleDateString('en-GB') : 'N/A' %></td>
                                        <td><%= row.PreviousValue || 'N/A' %></td>
                                        <td><%= row.NewValue || 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <footer class="mt-4 py-3 text-center text-muted border-top">
                <%- include('partials/footer') %>
            </footer>
        </div>
    </main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
