<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · Entity Head</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user, entityScope }) %>
    <%- include('../partials/sidebar') %>
    <main class="main"><div class="container-fluid py-3">
        <h2 class="mb-1"><%= title %></h2>
        <div class="text-muted mb-4">Final approval queue for sensitive records already endorsed by the Manager.</div>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <div class="card shadow-sm mb-4"><div class="card-body"><form method="GET" action="/entity-head/record-workflow" class="row g-3"><div class="col-md-4"><label class="form-label">Module</label><select class="form-select" name="module"><option value="">All Modules</option><% moduleOptions.forEach((option) => { %><option value="<%= option.value %>" <%= filters.module === option.value ? 'selected' : '' %>><%= option.label %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Status</label><select class="form-select" name="status"><% statusOptions.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></div><div class="col-md-4 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary w-100">Filter</button><a href="/entity-head/record-workflow" class="btn btn-outline-secondary">Reset</a></div></form></div></div>
        <div class="card shadow-sm"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Module</th><th>Reference</th><th>Status</th><th>Manager Endorsed</th><th class="text-end">Action</th></tr></thead><tbody><% if (!items.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No records matched the selected filters.</td></tr><% } %><% items.forEach((item) => { %><tr><td class="fw-semibold"><%= item.moduleLabel %></td><td><code><%= item.RecordReference %></code></td><td><span class="badge <%= getStatusBadgeClass(item.Status) %>"><%= item.Status %></span></td><td><%= item.ManagerEndorsedAt ? new Date(item.ManagerEndorsedAt).toLocaleString('en-GB') : 'N/A' %></td><td class="text-end"><a href="/entity-head/record-workflow/<%= item.id %>" class="btn btn-sm btn-outline-primary">Review</a></td></tr><% }) %></tbody></table></div></div></div>
        <footer class="mt-4 py-3 text-center text-muted border-top"><%- include('../partials/footer') %></footer>
    </div></main>
    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
