<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>
    <main class="main"><div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-1">Payroll Reversal Audit Review</h2><div class="text-muted">Review the original posting lines, reason, and Manager endorsement before forwarding for final approval.</div></div><a href="/auditor/payroll/reversals" class="btn btn-outline-secondary">Back to Queue</a></div>
        <% if (successMessage) { %><div class="alert alert-success"><%= successMessage %></div><% } %>
        <% if (errorMessage) { %><div class="alert alert-danger"><%= errorMessage %></div><% } %>
        <div class="row g-4 mb-4">
            <div class="col-xl-5"><div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Request Summary</span></div><div class="card-body"><dl class="row mb-0">
                <dt class="col-sm-5">Status</dt><dd class="col-sm-7"><span class="badge <%= detail.request.badgeClass %>"><%= detail.request.Status %></span></dd>
                <dt class="col-sm-5">Period</dt><dd class="col-sm-7"><%= String(detail.request.PMonth).padStart(2, '0') %>/<%= detail.request.PYear %></dd>
                <dt class="col-sm-5">Activity</dt><dd class="col-sm-7"><%= detail.request.PType %></dd>
                <dt class="col-sm-5">Reason</dt><dd class="col-sm-7"><%= detail.request.Reason %></dd>
                <dt class="col-sm-5">Manager Comment</dt><dd class="col-sm-7"><%= detail.request.ManagerComments || '—' %></dd>
            </dl></div></div></div>
            <div class="col-xl-7"><div class="card shadow-sm h-100"><div class="card-header"><span class="fw-semibold">Auditor Actions</span></div><div class="card-body">
                <% if (detail.request.Status === 'SUBMITTED_TO_AUDITOR') { %>
                    <form method="post" action="/auditor/payroll/reversals/<%= detail.request.id %>/endorse" class="mb-4">
                        <div class="mb-3"><label class="form-label">Audit Comment (optional)</label><textarea class="form-control" name="comments" rows="3"></textarea></div>
                        <button class="btn btn-success" type="submit">Endorse and Forward to Entity Head</button>
                    </form>
                    <form method="post" action="/auditor/payroll/reversals/<%= detail.request.id %>/return">
                        <div class="mb-3"><label class="form-label">Audit Findings / Return Reason</label><textarea class="form-control" name="comments" rows="3" required></textarea></div>
                        <button class="btn btn-warning" type="submit">Return to Finance</button>
                    </form>
                <% } else { %>
                    <div class="text-muted">This reversal request is no longer awaiting Auditor review.</div>
                <% } %>
            </div></div></div>
        </div>
        <div class="card shadow-sm mb-4"><div class="card-header"><span class="fw-semibold">GL Posting Lines</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>GL Account</th><th>Account Name</th><th>Entry Type</th><th>Amount</th><th>Narration</th></tr></thead>
            <tbody>
                <% if (!detail.postingDetail?.lines?.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No GL lines were found for this reversal request.</td></tr><% } %>
                <% (detail.postingDetail?.lines || []).forEach((line) => { %><tr><td><%= line.gl_account_code %></td><td><%= line.gl_account_name %></td><td><%= line.entry_type %></td><td><%= Number(line.amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= line.narration || '—' %></td></tr><% }) %>
            </tbody>
        </table></div></div></div>
        <div class="card shadow-sm"><div class="card-header"><span class="fw-semibold">Workflow History</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Action</th><th>From</th><th>To</th><th>Comments</th><th>When</th></tr></thead>
            <tbody>
                <% if (!detail.actions.length) { %><tr><td colspan="5" class="text-center text-muted py-4">No reversal workflow history recorded yet.</td></tr><% } %>
                <% detail.actions.forEach((action) => { %><tr><td><%= action.Action %></td><td><%= action.FromStatus || 'N/A' %></td><td><%= action.ToStatus %></td><td><%= action.Comments || '—' %></td><td><%= action.ActionAt ? new Date(action.ActionAt).toLocaleString('en-GB') : 'N/A' %></td></tr><% }) %>
            </tbody>
        </table></div></div></div>
    </div></main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
