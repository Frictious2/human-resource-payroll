<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Auditor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid py-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Payroll Review Detail</h2>
                    <p class="text-muted mb-0">Read-only audit review of the payroll batch, source references, and workflow history.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/auditor/payroll/review" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Queue</a>
                    <% if (canAct) { %>
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#endorseModal">
                            <i class="bi bi-check2-circle me-2"></i>Endorse to Entity Head
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#returnModal">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Return for Correction
                        </button>
                    <% } %>
                </div>
            </div>

            <% if (successMessage) { %>
                <div class="alert alert-success shadow-sm"><%= successMessage %></div>
            <% } %>
            <% if (errorMessage) { %>
                <div class="alert alert-danger shadow-sm"><%= errorMessage %></div>
            <% } %>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="text-muted small">Company</div>
                            <div class="fw-semibold"><%= batch.companyName || batch.CompanyID %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Payroll Month / Year</div>
                            <div class="fw-semibold"><%= String(batch.PMonth).padStart(2, '0') %>/<%= batch.PYear %></div>
                        </div>
                        <div class="col-md-2">
                            <div class="text-muted small">Activity</div>
                            <div class="fw-semibold"><%= batch.PType %> - <%= batch.activityName %></div>
                        </div>
                        <div class="col-md-2">
                            <div class="text-muted small">Workflow Status</div>
                            <div><span class="badge <%= getStatusBadgeClass(batch.Status) %>"><%= batch.Status %></span></div>
                        </div>
                        <div class="col-md-2">
                            <div class="text-muted small">Processed By</div>
                            <div class="fw-semibold"><%= batch.processedByName || batch.ProcessedBy || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Processed At</div>
                            <div class="fw-semibold"><%= batch.ProcessedAt ? new Date(batch.ProcessedAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Submitted by Finance</div>
                            <div class="fw-semibold"><%= batch.submittedToManagerByName || batch.SubmittedToManagerBy || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Submitted At</div>
                            <div class="fw-semibold"><%= batch.SubmittedToManagerAt ? new Date(batch.SubmittedToManagerAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Manager Endorsed By</div>
                            <div class="fw-semibold"><%= batch.managerEndorsedByName || batch.ManagerEndorsedBy || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Manager Endorsed At</div>
                            <div class="fw-semibold"><%= batch.managerEndorsedAt ? new Date(batch.managerEndorsedAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Manager Comments</div>
                            <div class="fw-semibold"><%= batch.ManagerComments || 'N/A' %></div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Auditor Comments</div>
                            <div class="fw-semibold"><%= batch.AuditorComments || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Final Decision By</div>
                            <div class="fw-semibold"><%= batch.finalDecisionByName || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Final Decision At</div>
                            <div class="fw-semibold"><%= batch.finalDecisionAt ? new Date(batch.finalDecisionAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Entity Head / HNO Comments</div>
                            <div class="fw-semibold"><%= batch.EntityHeadComments || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Posted By</div>
                            <div class="fw-semibold"><%= batch.postedToAccountsByName || 'N/A' %></div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-muted small">Posted At</div>
                            <div class="fw-semibold"><%= batch.postedToAccountsAt ? new Date(batch.postedToAccountsAt).toLocaleString('en-GB') : 'N/A' %></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Staff</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalStaff || 0).toLocaleString() %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Payroll Row Count</div><div class="fs-4 fw-semibold"><%= Number(batch.PayrollRowCount || 0).toLocaleString() %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Basic Salary</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalBasic || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Allowances</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalAllowances || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Gross</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalGross || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Taxable</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalTaxable || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Tax</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalTax || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Net Pay</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalNet || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total NASSIT Employee</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalNassitEmployee || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total NASSIT Employer</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalNassitEmployer || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Loan Deductions</div><div class="fs-4 fw-semibold"><%= Number(summaryBreakdown.totalLoanDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-3"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Medical Deductions</div><div class="fs-4 fw-semibold"><%= Number(summaryBreakdown.totalMedicalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Surcharge Deductions</div><div class="fs-4 fw-semibold"><%= Number(summaryBreakdown.totalSurchargeDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Other Deductions</div><div class="fs-4 fw-semibold"><%= Number(summaryBreakdown.totalOtherDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
                <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Total Deductions</div><div class="fs-4 fw-semibold"><%= Number(batch.TotalDeductions || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div></div></div></div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <span class="fw-semibold">Workflow History</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th>Actor</th>
                                    <th>Role</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Comments</th>
                                    <th>At</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!history.length) { %>
                                    <tr><td colspan="7" class="text-center text-muted py-4">No workflow history is available for this payroll batch.</td></tr>
                                <% } %>
                                <% history.forEach((entry) => { %>
                                    <tr>
                                        <td><%= entry.Action %></td>
                                        <td><%= entry.actorName || entry.ActionBy || 'N/A' %></td>
                                        <td><%= entry.actorRole || 'N/A' %></td>
                                        <td><%= entry.FromStatus || 'DRAFT' %></td>
                                        <td><%= entry.ToStatus %></td>
                                        <td><%= entry.Comments || '' %></td>
                                        <td><%= entry.ActionAt ? new Date(entry.ActionAt).toLocaleString('en-GB') : 'N/A' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Individual Employee Payroll Records</span>
                    <span class="small text-muted">Checksum: <%= batch.PayrollChecksum || 'N/A' %></span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>PFNo</th>
                                    <th>Staff Name</th>
                                    <th>Department</th>
                                    <th>Grade</th>
                                    <th>Job Title</th>
                                    <th class="text-end">Basic Salary</th>
                                    <th class="text-end">Allowances</th>
                                    <th class="text-end">Gross</th>
                                    <th class="text-end">Taxable</th>
                                    <th class="text-end">Tax</th>
                                    <th class="text-end">NassitEmp</th>
                                    <th class="text-end">NassitInst</th>
                                    <th class="text-end">Ded1 Loan</th>
                                    <th class="text-end">Ded6 Medical</th>
                                    <th class="text-end">Ded7 Surcharge</th>
                                    <th class="text-end">Ded2</th>
                                    <th class="text-end">Ded3</th>
                                    <th class="text-end">Ded4</th>
                                    <th class="text-end">Ded5</th>
                                    <th class="text-end">UnionDues</th>
                                    <th class="text-end">GratEmp</th>
                                    <th class="text-end">Total Deductions</th>
                                    <th class="text-end">NetIncome</th>
                                    <th>Pay Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!payrollRows.length) { %>
                                    <tr><td colspan="24" class="text-center text-muted py-4">No payroll rows were found for this batch.</td></tr>
                                <% } %>
                                <% payrollRows.forEach((row) => { %>
                                    <tr>
                                        <td><%= row.PFNo %></td>
                                        <td><%= row.StaffName || '' %></td>
                                        <td><%= row.DeptName || row.DeptCode || '' %></td>
                                        <td><%= row.GradeName || row.GradeCode || '' %></td>
                                        <td><%= row.JobTitle || '' %></td>
                                        <td class="text-end"><%= Number(row.Salary || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.AllowanceTotal || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.TotalIncome || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Taxable || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Tax || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.NassitEmployee || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.NassitEmployer || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.LoanDeduction || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.MedicalDeduction || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.SurchargeDeduction || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Ded2 || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Ded3 || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Ded4 || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.Ded5 || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.UnionDues || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.GratEmp || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.DeductionTotal || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td class="text-end"><%= Number(row.NetIncome || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                        <td>
                                            <% if (Number(row.FullPay || 0) !== 0) { %>
                                                <span class="badge text-bg-success">Full Pay</span>
                                            <% } else if (Number(row.HalfPay || 0) !== 0) { %>
                                                <span class="badge text-bg-warning">Half Pay</span>
                                            <% } else if (Number(row.WithoutPay || 0) !== 0) { %>
                                                <span class="badge text-bg-secondary">Without Pay</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-dark border">N/A</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Approved Salary Queries</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>PFNo</th><th>QDate</th><th>Response</th><th>Details</th></tr></thead>
                                    <tbody>
                                        <% if (!sourceReferences.queryAdjustments.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No approved salary query adjustments found.</td></tr><% } %>
                                        <% sourceReferences.queryAdjustments.forEach((row) => { %>
                                            <tr><td><%= row.PFNo %></td><td><%= row.QDate ? new Date(row.QDate).toLocaleDateString('en-GB') : 'N/A' %></td><td><%= row.MResponse || '' %></td><td><%= row.QDetails || '' %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Loan Deductions Reference</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>PFNo</th><th>Monthly Repayment</th><th>Monthly Int</th><th>Balance</th></tr></thead>
                                    <tbody>
                                        <% if (!sourceReferences.loans.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No active loan references found.</td></tr><% } %>
                                        <% sourceReferences.loans.forEach((row) => { %>
                                            <tr><td><%= row.PFNo %></td><td><%= Number(row.MonthlyRepayment || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= Number(row.MonthlyInt || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= Number(row.LoanBal || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Loan Repayment Trail</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>PFNo</th><th>Deduction Date</th><th>Amount</th><th>Ref</th></tr></thead>
                                    <tbody>
                                        <% if (!sourceReferences.loanRepayments.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No loan repayment trail found for this payroll period.</td></tr><% } %>
                                        <% sourceReferences.loanRepayments.forEach((row) => { %>
                                            <tr><td><%= row.PFNo %></td><td><%= row.DeductionDate ? new Date(row.DeductionDate).toLocaleDateString('en-GB') : 'N/A' %></td><td><%= Number(row.DAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= row.TransRef || '' %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Medical Deductions Reference</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>PFNo</th><th>Entry Date</th><th>Amount</th><th>Description</th></tr></thead>
                                    <tbody>
                                        <% if (!sourceReferences.medical.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No medical deduction references found.</td></tr><% } %>
                                        <% sourceReferences.medical.forEach((row) => { %>
                                            <tr><td><%= row.PFNo %></td><td><%= row.EntryDate ? new Date(row.EntryDate).toLocaleDateString('en-GB') : 'N/A' %></td><td><%= Number(row.Amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= row.Details || row.Description || '' %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header"><span class="fw-semibold">Surcharge Reference</span></div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light"><tr><th>PFNo</th><th>Amount</th><th>Start</th><th>End</th></tr></thead>
                                    <tbody>
                                        <% if (!sourceReferences.surcharges.length) { %><tr><td colspan="4" class="text-center text-muted py-3">No surcharge references found.</td></tr><% } %>
                                        <% sourceReferences.surcharges.forEach((row) => { %>
                                            <tr><td><%= row.PFNo %></td><td><%= Number(row.SAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td><td><%= row.SDate ? new Date(row.SDate).toLocaleDateString('en-GB') : (row.StarDate ? new Date(row.StarDate).toLocaleDateString('en-GB') : 'N/A') %></td><td><%= row.EDate ? new Date(row.EDate).toLocaleDateString('en-GB') : (row.ExpDate ? new Date(row.ExpDate).toLocaleDateString('en-GB') : 'N/A') %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <% if (canAct) { %>
                <div class="modal fade" id="endorseModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="POST" action="/auditor/payroll/review/<%= batch.id %>/endorse">
                                <div class="modal-header">
                                    <h5 class="modal-title">Confirm Audit Endorsement</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-3">This will endorse the payroll batch and forward it to the Entity Head/HNO.</p>
                                    <label for="endorseComments" class="form-label">Audit Notes (optional)</label>
                                    <textarea class="form-control" id="endorseComments" name="comments" rows="4" placeholder="Optional audit notes"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">Confirm Endorsement</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="POST" action="/auditor/payroll/review/<%= batch.id %>/return">
                                <div class="modal-header">
                                    <h5 class="modal-title">Return Payroll for Correction</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="mb-3">Provide the audit findings or reason for returning this payroll batch.</p>
                                    <label for="returnComments" class="form-label">Audit Findings</label>
                                    <textarea class="form-control" id="returnComments" name="comments" rows="4" required placeholder="Please provide the audit findings or reason for returning the payroll."></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Return for Correction</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% } %>

            <footer class="mt-4 py-3 text-center text-muted border-top">
                <%- include('../partials/footer') %>
            </footer>
        </div>
    </main>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
</body>
</html>
