<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= workspaceLabel %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        .report-workspace { background: linear-gradient(180deg, #eef2f7 0%, #f6f7fb 100%); min-height: 100vh; }
        .report-toolbar { position: sticky; top: 76px; z-index: 10; }
        .report-toolbar .card-body { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between; }
        .viewer-nav { display: flex; align-items: center; gap: .75rem; }
        .viewer-meta { min-width: 12rem; text-align: center; font-weight: 600; }
        .report-printable { width: min(100%, 210mm); margin: 0 auto; }
        .report-page {
            background: #fff;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 14px;
            margin-bottom: 1.5rem;
            padding: 18mm 14mm 14mm;
            min-height: calc(297mm - 24mm);
            box-sizing: border-box;
            overflow: hidden;
            break-inside: avoid-page;
            page-break-inside: avoid;
        }
        .report-page:not(.active) { display: none; }
        .report-printable.viewer-export-mode .report-page { display: block !important; }
        .report-branding { text-align: center; border-bottom: 1px solid rgba(15, 23, 42, 0.12); padding-bottom: 1rem; margin-bottom: 1.25rem; }
        .report-logo-wrap { min-height: 76px; display: flex; align-items: center; justify-content: center; margin-bottom: .75rem; }
        .report-logo { max-height: 72px; max-width: 120px; object-fit: contain; }
        .report-company { font-size: 1.15rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
        .report-address, .report-subtitle { color: #5b6470; margin-top: .2rem; }
        .nra-header { margin-bottom: .85rem; }
        .nra-logo-wrap { min-height: 86px; display: flex; align-items: center; justify-content: center; margin-bottom: .5rem; }
        .nra-logo { max-height: 80px; max-width: 160px; object-fit: contain; }
        .nra-title { font-size: 1.05rem; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; }
        .report-title { font-size: 1rem; font-weight: 700; letter-spacing: .03em; margin-top: .95rem; text-transform: uppercase; }
        .report-table {
            width: 100%;
            table-layout: fixed;
            margin-bottom: 0;
        }
        .report-table th, .report-table td {
            vertical-align: middle;
            font-size: .88rem;
            word-break: break-word;
            overflow-wrap: anywhere;
            padding: .42rem .45rem;
        }
        .report-table th { line-height: 1.2; }
        .report-table td { line-height: 1.15; }
        .report-table thead { display: table-header-group; }
        .report-table tbody tr,
        .report-table tfoot tr,
        .declaration-box,
        .row,
        .table-responsive {
            break-inside: avoid-page;
            page-break-inside: avoid;
        }
        .table-responsive { overflow: visible; }
        .declaration-box { border: 1px solid rgba(15, 23, 42, 0.12); border-radius: .75rem; padding: 1rem; background: #f8fafc; }
        .report-page-footer {
            display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: .75rem;
            border-top: 1px solid rgba(15, 23, 42, 0.12); color: #55606d; font-size: .88rem;
        }
        @media print {
            body { background: #fff !important; }
            .topbar, .sidebar, .d-print-none, .report-toolbar { display: none !important; }
            .main, .container-fluid { margin: 0 !important; padding: 0 !important; }
            .report-workspace, .report-printable { background: transparent !important; max-width: none !important; width: auto !important; }
            .report-page, .report-page:not(.active) {
                display: block !important; box-shadow: none !important; border: 0 !important; border-radius: 0 !important;
                margin: 0 !important; padding: 0 !important; min-height: auto !important; overflow: visible !important; break-after: page; page-break-after: always;
            }
            .report-page:last-child { break-after: auto; page-break-after: auto; }
            @page { size: A4 portrait; margin: 12mm 10mm 18mm; }
        }
    </style>
</head>
<body>
    <% const reportBasePath = (path || '/finance/reports/payroll-liabilities/preview').replace(/\/preview$|\/pdf$/, ''); %>
    <%- include('../../' + partialsBase + '/topbar', { user, branding }) %>
    <%- include('../../' + partialsBase + '/sidebar') %>

    <main class="main report-workspace">
        <div class="container-fluid py-4">
            <div class="d-flex justify-content-between align-items-start mb-4 d-print-none">
                <div>
                    <h1 class="h3 mb-1"><%= pageData.report.shortTitle %></h1>
                </div>
            </div>

            <div class="card shadow-sm mb-3 d-print-none report-toolbar">
                <div class="card-body">
                    <div class="viewer-nav">
                        <button type="button" class="btn btn-outline-secondary" data-report-prev>Previous</button>
                        <div class="viewer-meta" data-report-indicator>Page 1 of 1</div>
                        <button type="button" class="btn btn-outline-secondary" data-report-next>Next</button>
                    </div>
                    <div class="text-muted small text-center flex-grow-1" data-report-detail></div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="<%= reportBasePath %>" class="btn btn-outline-secondary">Change Filters</a>
                        <a href="<%= reportBasePath %>/excel?<%= new URLSearchParams({ liabilityType: pageData.filters.liabilityType, fromDate: pageData.filters.fromDate, toDate: pageData.filters.toDate }).toString() %>" class="btn btn-success" <%= !pageData.report.supported ? 'aria-disabled="true"' : '' %>>
                            Download Excel
                        </a>
                        <button type="button" class="btn btn-outline-dark" id="toolbarPrintButton">Print</button>
                        <button type="button" class="btn btn-danger" id="toolbarPdfButton" <%= !pageData.report.supported ? 'disabled' : '' %>>Download PDF</button>
                    </div>
                </div>
            </div>

            <div id="liabilityPrintable" class="report-printable" data-report-viewer>
                <% pageData.pages.forEach((page) => { %>
                    <section class="report-page" data-report-page data-page-label="<%= pageData.report.shortTitle %>">
                        <div class="report-branding">
                            <% if (pageData.report.liabilityType === 'PAYE' || pageData.report.liabilityType === 'EOS') { %>
                                <div class="nra-header text-center">
                                    <div class="nra-logo-wrap">
                                        <img
                                            src="<%= pageData.report.nraLogoPath %>"
                                            alt="National Revenue Authority Logo"
                                            class="nra-logo"
                                            data-authoritative-src="<%= pageData.report.nraLogoSourceUrl %>"
                                        />
                                    </div>
                                    <h3 class="nra-title mb-0">INCOME TAX DEPARTMENT</h3>
                                </div>
                            <% } else if (pageData.company.LogoPath) { %>
                                <div class="report-logo-wrap">
                                    <img src="<%= pageData.company.LogoPath %>" alt="Company Logo" class="report-logo" />
                                </div>
                            <% } %>
                            <% if (pageData.report.liabilityType === 'NASSIT') { %>
                                <div class="report-company"><%= pageData.company.Com_Name %></div>
                                <% if (pageData.company.fullAddress) { %>
                                    <div class="report-address"><%= pageData.company.fullAddress %></div>
                                <% } %>
                            <% } %>
                            <div class="report-title"><%= pageData.report.title %></div>
                            <div class="report-subtitle"><%= pageData.report.subtitle %></div>
                        </div>

                        <% if (!pageData.rows.length) { %>
                            <div class="alert alert-info"><%= pageData.report.emptyMessage %></div>
                        <% } else { %>
                            <% if (pageData.report.liabilityType === 'PAYE') { %>
                                <div class="row g-3 mb-3 small">
                                    <div class="col-md-6">
                                        <div><strong>Employer's Name:</strong> <%= pageData.company.Com_Name %></div>
                                        <div><strong>Address:</strong> <%= pageData.company.fullAddress || '-' %></div>
                                    </div>
                                    <div class="col-md-6">
                                        <div><strong>Contact:</strong> <%= pageData.report.employerContact || '-' %></div>
                                        <div><strong>TIN:</strong> <%= pageData.report.employerTin || '-' %></div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-bordered report-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 6%">Serial No</th>
                                                <th>Employee's Name</th>
                                                <th>Emp-ID</th>
                                                <th class="text-end">Basic Monthly Salary</th>
                                                <th class="text-end">Less NASSIT Deduction</th>
                                                <th class="text-end">Monthly Allowance</th>
                                                <th class="text-end">Gross Monthly Emoluments</th>
                                                <th class="text-end">Tax Deducted</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% page.rows.forEach((row) => { %>
                                                <tr>
                                                    <td class="text-center"><%= row.RowNo %></td>
                                                    <td><%= row.StaffName %></td>
                                                    <td><%= row.PFNo %></td>
                                                    <td class="text-end"><%= row.BasicMonthlySalary.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.NassitDeduction.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.MonthlyAllowance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.GrossMonthlyEmoluments.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.TaxDeducted.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                        <% if (page.pageNumber === page.totalPages) { %>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <th colspan="3">Totals</th>
                                                    <th class="text-end"><%= pageData.totals.basic.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.nassit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.allowance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.gross.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.tax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                </tr>
                                            </tfoot>
                                        <% } %>
                                    </table>
                                </div>
                            <% } %>

                            <% if (pageData.report.liabilityType === 'NASSIT') { %>
                                <div class="table-responsive">
                                    <table class="table table-bordered report-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 6%">No.</th>
                                                <th>NASSIT No</th>
                                                <th>Name</th>
                                                <th>Emp-ID</th>
                                                <th class="text-end">Monthly Salary</th>
                                                <th class="text-end">Emp Contribution</th>
                                                <th class="text-end">Inst Contribution</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% page.rows.forEach((row) => { %>
                                                <tr>
                                                    <td class="text-center"><%= row.RowNo %></td>
                                                    <td><%= row.NassitNo || '-' %></td>
                                                    <td><%= row.StaffName %></td>
                                                    <td><%= row.PFNo %></td>
                                                    <td class="text-end"><%= row.MonthlySalary.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.EmployeeContribution.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.EmployerContribution.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.TotalContribution.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                        <% if (page.pageNumber === page.totalPages) { %>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <th colspan="4">Totals</th>
                                                    <th class="text-end"><%= pageData.totals.salary.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.employee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.employer.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                </tr>
                                            </tfoot>
                                        <% } %>
                                    </table>
                                </div>
                            <% } %>

                            <% if (pageData.report.liabilityType === 'EOS') { %>
                                <div class="table-responsive">
                                    <table class="table table-bordered report-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 6%">Serial No</th>
                                                <th>Employee's Name</th>
                                                <th>Emp-ID</th>
                                                <th class="text-end">Total EOS Benefit</th>
                                                <th class="text-end">Taxable Leave Allowance</th>
                                                <th class="text-end">Tax Deducted</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% page.rows.forEach((row) => { %>
                                                <tr>
                                                    <td class="text-center"><%= row.RowNo %></td>
                                                    <td><%= row.StaffName %></td>
                                                    <td><%= row.PFNo %></td>
                                                    <td class="text-end"><%= row.TotalEOSBenefit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.TaxableLeaveAllowance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                    <td class="text-end"><%= row.TaxDeducted.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                        <% if (page.pageNumber === page.totalPages) { %>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <th colspan="3">Totals</th>
                                                    <th class="text-end"><%= pageData.totals.eosBenefit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.taxableLeave.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                    <th class="text-end"><%= pageData.totals.tax.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></th>
                                                </tr>
                                            </tfoot>
                                        <% } %>
                                    </table>
                                </div>
                                <% if (page.pageNumber === page.totalPages) { %>
                                    <div class="declaration-box mt-4">
                                        <p class="mb-3"><%= pageData.report.declarationText %></p>
                                        <div class="row g-4 mt-3">
                                            <div class="col-md-4"><div class="border-top pt-2">Designation</div></div>
                                            <div class="col-md-4"><div class="border-top pt-2">Signature</div></div>
                                            <div class="col-md-4"><div class="border-top pt-2">Date</div></div>
                                        </div>
                                    </div>
                                <% } %>
                            <% } %>
                        <% } %>
                        <div class="report-page-footer">
                            <span><%= pageData.report.printDateLabel %></span>
                            <span>Page <%= page.pageNumber %> of <%= page.totalPages %></span>
                        </div>
                    </section>
                <% }) %>
            </div>
        </div>
    </main>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
    <script src="/js/report-viewer.js"></script>
    <script>
        const printable = document.getElementById('liabilityPrintable');
        const toolbarPrintButton = document.getElementById('toolbarPrintButton');
        const toolbarPdfButton = document.getElementById('toolbarPdfButton');
        const viewer = printable ? window.initializeReportViewer() : null;

        async function downloadPdf() {
            if (!printable || !viewer || <%= pageData.report.supported ? 'false' : 'true' %>) return;
            await viewer.withAllPages(async () => {
                const opt = {
                    margin: [10, 8, 18, 8],
                    filename: <%- JSON.stringify(pageData.filenames.pdf) %>,
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2, useCORS: true },
                    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                    pagebreak: { mode: ['css', 'legacy'] }
                };
                const worker = html2pdf().set(opt).from(printable).toPdf();
                const pdf = await worker.get('pdf');
                const totalPages = pdf.internal.getNumberOfPages();
                const footerDate = <%- JSON.stringify(pageData.report.printDateLabel) %>;
                for (let page = 1; page <= totalPages; page += 1) {
                    pdf.setPage(page);
                    const width = pdf.internal.pageSize.getWidth();
                    const height = pdf.internal.pageSize.getHeight();
                    pdf.setFontSize(9);
                    pdf.text(footerDate, 10, height - 6);
                    pdf.text(`Page ${page} of ${totalPages}`, width - 10, height - 6, { align: 'right' });
                }
                await worker.save();
            });
        }

        if (toolbarPrintButton) {
            toolbarPrintButton.addEventListener('click', () => window.print());
        }
        if (toolbarPdfButton) {
            toolbarPdfButton.addEventListener('click', downloadPdf);
        }
        if (<%= pageData.filters.autoDownloadPdf ? 'true' : 'false' %>) {
            window.addEventListener('load', () => {
                setTimeout(() => downloadPdf(), 250);
            });
        }
    </script>
</body>
</html>
