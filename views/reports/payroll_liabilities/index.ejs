<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= workspaceLabel %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
    <style>
        .report-shell {
            background: linear-gradient(180deg, #eef2f7 0%, #f8fafc 100%);
            min-height: 100vh;
        }
        .hero-card {
            border: 0;
            border-radius: 1.25rem;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #334155 100%);
            color: #fff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.18);
        }
        .hero-eyebrow {
            text-transform: uppercase;
            letter-spacing: .12em;
            font-size: .78rem;
            opacity: .8;
        }
        .option-tile {
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 1rem;
            padding: 1rem;
            background: #fff;
            height: 100%;
        }
        .staff-summary {
            min-height: 2.25rem;
        }
    </style>
</head>
<body>
    <% const reportBasePath = (path || '/finance/reports/payroll-liabilities').replace(/\/$/, ''); %>
    <%- include('../../' + partialsBase + '/topbar', { user, branding }) %>
    <%- include('../../' + partialsBase + '/sidebar') %>

    <main class="main report-shell">
        <div class="container-fluid py-4">
            <div class="card hero-card mb-4">
                <div class="card-body p-4 p-lg-5">
                    <div class="hero-eyebrow mb-2">Finance Reports</div>
                    <h1 class="display-6 fw-semibold mb-2">Payroll Liabilities</h1>
                    <p class="mb-0 text-white-50">Generate PAYE, EOS Benefit, and NASSIT liability reports using the verified payroll and EOS sources, while keeping the original filter page open for quick refinements.</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-xl-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                                <div>
                                    <h2 class="h4 mb-1">Select Date Range for Liabilities</h2>
                                    <p class="text-muted mb-0">Preview opens in a new tab so this filter page stays available for quick changes.</p>
                                </div>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#staffPayeModal">
                                    <i class="bi bi-person-vcard me-2"></i>Staff
                                </button>
                            </div>

                            <form id="liabilityForm" method="GET" action="<%= reportBasePath %>/preview" target="_blank" class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Select Liability</label>
                                    <div class="row g-3">
                                        <% pageData.liabilityTypeOptions.forEach((option) => { %>
                                            <div class="col-md-6 col-xl-4">
                                                <label class="option-tile d-block">
                                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                        <div class="form-check">
                                                            <input
                                                                class="form-check-input liability-type"
                                                                type="radio"
                                                                name="liabilityType"
                                                                id="liability-<%= option.value %>"
                                                                value="<%= option.value %>"
                                                                <%= pageData.filters.liabilityType === option.value ? 'checked' : '' %>
                                                            />
                                                            <span class="form-check-label fw-semibold"><%= option.label %></span>
                                                        </div>
                                                        <span class="badge rounded-pill bg-success-subtle text-success-emphasis">Supported</span>
                                                    </div>
                                                    <small class="text-muted d-block">Available for preview, PDF, and Excel export.</small>
                                                </label>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label">From</label>
                                    <input type="date" class="form-control" name="fromDate" value="<%= pageData.filters.fromDate %>" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">To</label>
                                    <input type="date" class="form-control" name="toDate" value="<%= pageData.filters.toDate %>" required />
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div id="liabilitySupportNote" class="alert alert-success w-100 mb-0 py-2 small">PAYE, EOS Benefit, and NASSIT are the only supported Payroll Liability report types in this module.</div>
                                </div>

                                <div class="col-12 d-flex gap-2 flex-wrap">
                                    <button type="submit" class="btn btn-primary" id="previewButton">
                                        <i class="bi bi-eye me-2"></i>Preview
                                    </button>
                                    <button type="submit" class="btn btn-danger" id="pdfButton" formaction="<%= reportBasePath %>/pdf" formtarget="_blank">
                                        <i class="bi bi-file-earmark-pdf me-2"></i>PDF
                                    </button>
                                    <button type="submit" class="btn btn-success" id="excelButton" formaction="<%= reportBasePath %>/excel" formtarget="_blank">
                                        <i class="bi bi-file-earmark-excel me-2"></i>Excel
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#staffPayeModal">
                                        <i class="bi bi-person-vcard me-2"></i>Staff PAYE Statement
                                    </button>
                                    <a href="<%= reportBasePath %>" class="btn btn-outline-secondary">Clear</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body p-4">
                            <h3 class="h5 mb-3">What This Uses</h3>
                            <ul class="text-muted ps-3 mb-0">
                                <li>PAYE uses effective approved payroll values from `tblpayroll`.</li>
                                <li>NASSIT uses `Salary`, `NassitEmp`, and `NassitInst` from effective payroll rows.</li>
                                <li>EOS Benefit uses approved EOS budget rows.</li>
                                <li>Reversed payroll generations are excluded from payroll-based liabilities.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="staffPayeModal" tabindex="-1" aria-labelledby="staffPayeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staffPayeModalLabel">Staff PAYE Statement of Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="GET" action="<%= reportBasePath %>/staff-preview" target="_blank">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">PFNo / Staff ID</label>
                                <input type="text" class="form-control" name="pfNo" id="staffPfNo" value="<%= pageData.staffFilters.pfNo %>" placeholder="Enter PFNo" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" name="fromDate" value="<%= pageData.staffFilters.fromDate %>" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">End Date</label>
                                <input type="date" class="form-control" name="toDate" value="<%= pageData.staffFilters.toDate %>" required />
                            </div>
                            <div class="col-12">
                                <div class="staff-summary small text-muted" id="staffLookupSummary">Enter a PFNo from your company, then preview the statement in a new tab.</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-eye me-2"></i>Preview
                        </button>
                        <button type="submit" class="btn btn-danger" formaction="<%= reportBasePath %>/staff-pdf" formtarget="_blank">
                            <i class="bi bi-file-earmark-pdf me-2"></i>PDF
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/vendor/bootstrap.bundle.min.js"></script>
    <script>
        const staffInput = document.getElementById('staffPfNo');
        const staffSummary = document.getElementById('staffLookupSummary');

        if (staffInput && staffSummary) {
            staffInput.addEventListener('input', () => {
                staffSummary.textContent = staffInput.value.trim()
                    ? `Statement preview will validate PFNo ${staffInput.value.trim()} against your authenticated company before opening in a new tab.`
                    : 'Enter a PFNo from your company, then preview the statement in a new tab.';
            });
        }
    </script>
</body>
</html>
