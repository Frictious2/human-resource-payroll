<%
  const summary = typeof notificationSummary !== 'undefined' && notificationSummary
    ? notificationSummary
    : { unreadCount: 0, recent: [] };
  const unreadCount = Number(summary.unreadCount || 0);
  const recentNotifications = Array.isArray(summary.recent) ? summary.recent : [];
%>
<li class="nav-item dropdown">
  <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
    <i class="bi bi-bell fs-5"></i>
    <% if (unreadCount > 0) { %>
      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
        <%= unreadCount > 99 ? '99+' : unreadCount %>
      </span>
    <% } %>
  </a>
  <div class="dropdown-menu dropdown-menu-end shadow p-0" style="min-width: 22rem;">
    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
      <div>
        <div class="fw-semibold">Notifications</div>
        <div class="small text-muted"><%= unreadCount %> unread</div>
      </div>
      <form action="/notifications/read-all" method="POST" class="m-0">
        <button type="submit" class="btn btn-link btn-sm text-decoration-none p-0">Mark all as read</button>
      </form>
    </div>
    <% if (!recentNotifications.length) { %>
      <div class="px-3 py-4 text-center text-muted small">No notifications yet.</div>
    <% } else { %>
      <div class="list-group list-group-flush">
        <% recentNotifications.slice(0, 8).forEach((notification) => { %>
          <a href="/notifications/<%= notification.id %>/open" class="list-group-item list-group-item-action <%= notification.IsRead ? '' : 'fw-semibold' %>">
            <div class="d-flex justify-content-between gap-2">
              <span class="me-2"><%= notification.Title %></span>
              <small class="text-muted text-nowrap"><%= notification.CreatedAt ? new Date(notification.CreatedAt).toLocaleString('en-GB') : '' %></small>
            </div>
            <div class="small text-muted mt-1"><%= notification.Message %></div>
          </a>
        <% }) %>
      </div>
    <% } %>
    <div class="border-top px-3 py-2 text-end">
      <a href="/notifications" class="small text-decoration-none">View all notifications</a>
    </div>
  </div>
</li>
