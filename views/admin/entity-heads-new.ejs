<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Add Entity Head</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
  <%- include('partials/topbar', { user }) %>
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="container-fluid">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="mb-0">Add Entity Head</h2>
        <a class="btn btn-outline-secondary" href="/admin/entity-heads"><i class="bi bi-arrow-left me-2"></i>Back to Entity Heads</a>
      </div>

      <% if (error) { %><div class="alert alert-danger shadow-sm"><%= error %></div><% } %>

      <div class="alert alert-info shadow-sm">
        Entity Head accounts are read-only and are scoped from a current active HOD staff record. The login username is set to the selected staff PFNo so the scope resolver can bind safely without changing the legacy schema.
      </div>

      <div class="card shadow-sm">
        <div class="card-body">
          <form action="/admin/entity-heads" method="post">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Current HOD Staff</label>
                <select class="form-select" id="staffSelect" name="StaffPFNo" required>
                  <option value="">Select HOD staff</option>
                  <% candidates.forEach((candidate) => { %>
                    <option
                      value="<%= candidate.PFNo %>"
                      data-name="<%= candidate.SName %>"
                      data-email="<%= candidate.Email || '' %>"
                      data-dept="<%= candidate.DeptName || candidate.CDept || '' %>">
                      <%= candidate.PFNo %> - <%= candidate.SName %> (<%= candidate.DeptName || candidate.CDept || 'No Dept' %>)
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Assigned Entity / Department</label>
                <input id="deptPreview" type="text" class="form-control" value="" readonly />
              </div>
              <div class="col-md-4">
                <label class="form-label">Username</label>
                <input id="usernamePreview" type="text" class="form-control" value="" readonly />
                <div class="form-text">Username is fixed to the selected staff PFNo.</div>
              </div>
              <div class="col-md-4">
                <label class="form-label">Full Name</label>
                <input id="fullNamePreview" type="text" class="form-control" value="" readonly />
              </div>
              <div class="col-md-4">
                <label class="form-label">Email</label>
                <input id="emailInput" name="Email" type="email" class="form-control" required />
              </div>
            </div>
            <div class="mt-4">
              <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-2"></i>Create Entity Head</button>
            </div>
          </form>
        </div>
      </div>

      <footer class="mt-4 py-3 text-center text-muted border-top">
        <%- include('partials/footer') %>
      </footer>
    </div>
  </main>

  <script src="/vendor/bootstrap.bundle.min.js"></script>
  <script>
    (function () {
      const staffSelect = document.getElementById('staffSelect');
      const usernamePreview = document.getElementById('usernamePreview');
      const fullNamePreview = document.getElementById('fullNamePreview');
      const emailInput = document.getElementById('emailInput');
      const deptPreview = document.getElementById('deptPreview');

      function syncFields() {
        const option = staffSelect.options[staffSelect.selectedIndex];
        if (!option || !option.value) {
          usernamePreview.value = '';
          fullNamePreview.value = '';
          deptPreview.value = '';
          emailInput.value = '';
          return;
        }

        usernamePreview.value = option.value;
        fullNamePreview.value = option.dataset.name || '';
        deptPreview.value = option.dataset.dept || '';
        emailInput.value = option.dataset.email || '';
      }

      staffSelect.addEventListener('change', syncFields);
      syncFields();
    })();
  </script>
</body>
</html>
