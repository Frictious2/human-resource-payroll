<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= group %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Departments</h2>
                    <div class="text-muted">Department maintenance now uses the approval workflow. Live `tbldept` rows stay unchanged until the Entity Head/HNO approves a proposal.</div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/admin/parameter-changes?module=departments" class="btn btn-outline-secondary">Open Proposals</a>
                    <button class="btn btn-primary" type="button" id="createDepartmentBtn">
                        <i class="bi bi-plus-circle me-2"></i>Create Department Proposal
                    </button>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Search</label>
                            <input id="searchInput" class="form-control" placeholder="Search code or department name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Workflow Status</label>
                            <select id="statusFilter" class="form-select">
                                <option value="">All</option>
                                <option value="DRAFT">Draft</option>
                                <option value="RETURNED_BY_ENTITY_HEAD">Returned</option>
                                <option value="SUBMITTED_TO_ENTITY_HEAD">Awaiting Approval</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button id="resetFiltersBtn" class="btn btn-outline-secondary w-100" type="button">Reset Filters</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Live Departments</span>
                    <span class="text-muted small" id="liveSummary">0 live rows</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="departmentsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Department Name</th>
                                    <th>Historical Usage</th>
                                    <th>Latest Pending Proposal</th>
                                    <th>Workflow Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Pending Create Proposals Not Yet In Live `tbldept`</span>
                    <span class="text-muted small" id="pendingSummary">0 pending create proposals</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="pendingCreateTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Proposed Code</th>
                                    <th>Proposed Department</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th class="text-end">Open</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="departmentModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="departmentModalTitle">Create Department Proposal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="departmentForm">
                        <input type="hidden" id="formMode" value="create">
                        <input type="hidden" id="originalCode" value="">
                        <div class="mb-3">
                            <label class="form-label">Department Name</label>
                            <input type="text" class="form-control" id="departmentName" maxlength="100" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason for Change</label>
                            <textarea class="form-control" id="departmentReason" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="saveDepartmentBtn">Save Proposal</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteProposalModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Propose Department Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">This only creates a deletion proposal. The live department remains unchanged unless the Entity Head/HNO approves it.</p>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" id="deleteReason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteProposalBtn">Save Deletion Proposal</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let liveRows = [];
        let pendingCreates = [];
        let selectedDeleteCode = '';

        const departmentModal = new bootstrap.Modal(document.getElementById('departmentModal'));
        const deleteProposalModal = new bootstrap.Modal(document.getElementById('deleteProposalModal'));

        function badgeClass(status) {
            switch (status) {
                case 'DRAFT': return 'bg-secondary-subtle text-secondary-emphasis';
                case 'RETURNED_BY_ENTITY_HEAD': return 'bg-info-subtle text-info-emphasis';
                case 'SUBMITTED_TO_ENTITY_HEAD': return 'bg-warning-subtle text-warning-emphasis';
                case 'APPLIED': return 'bg-success-subtle text-success-emphasis';
                default: return 'bg-light text-dark';
            }
        }

        async function loadDepartments() {
            const response = await fetch('/admin/api/parameters/departments');
            const json = await response.json();
            if (!response.ok) {
                throw new Error(json.error || 'Failed to load departments');
            }

            liveRows = json.data.liveRows || [];
            pendingCreates = json.data.pendingCreates || [];
            renderTables();
        }

        function renderTables() {
            const term = String(document.getElementById('searchInput').value || '').toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;

            const filteredLive = liveRows.filter((row) => {
                const matchesText = [row.Code, row.Dept, row.latestPendingStatus || ''].some((value) => String(value || '').toLowerCase().includes(term));
                const matchesStatus = !statusFilter || row.latestPendingStatus === statusFilter;
                return matchesText && matchesStatus;
            });

            const tbody = document.querySelector('#departmentsTable tbody');
            tbody.innerHTML = '';
            if (!filteredLive.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No departments found.</td></tr>';
            } else {
                filteredLive.forEach((row) => {
                    const requestUrl = row.latestPendingRequest ? `/admin/parameter-changes/${row.latestPendingRequest.id}` : '';
                    const usageCount = Number(row.usage?.total || 0);
                    const editableLiveProposal = row.latestPendingStatus === 'DRAFT' || row.latestPendingStatus === 'RETURNED_BY_ENTITY_HEAD';
                    const lockedLiveProposal = row.latestPendingStatus === 'SUBMITTED_TO_ENTITY_HEAD';
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="fw-semibold">${row.Code || ''}</td>
                        <td>${row.Dept || ''}</td>
                        <td>${usageCount} staff assignment(s)</td>
                        <td>${row.latestPendingRequest ? `${row.latestPendingRequest.ChangeType} proposal` : '<span class="text-muted">None</span>'}</td>
                        <td>${row.latestPendingStatus ? `<span class="badge ${badgeClass(row.latestPendingStatus)}">${row.latestPendingStatus}</span>` : '<span class="text-muted">—</span>'}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" ${lockedLiveProposal ? 'disabled' : ''} onclick="openEditModal('${row.Code}', ${JSON.stringify(String(row.Dept || '')).replace(/"/g, '&quot;')})">${editableLiveProposal ? 'Edit Draft' : 'Edit'}</button>
                                ${requestUrl ? `<a class="btn btn-outline-secondary" href="${requestUrl}">Proposal</a>` : ''}
                                <button type="button" class="btn btn-outline-danger" ${lockedLiveProposal ? 'disabled' : ''} onclick="openDeleteModal('${row.Code}', ${row.canDelete ? 'true' : 'false'})">Delete</button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            const pendingBody = document.querySelector('#pendingCreateTable tbody');
            pendingBody.innerHTML = '';
            if (!pendingCreates.length) {
                pendingBody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No pending create proposals are waiting outside the live table.</td></tr>';
            } else {
                pendingCreates.forEach((row) => {
                    const editablePendingCreate = row.Status === 'DRAFT' || row.Status === 'RETURNED_BY_ENTITY_HEAD';
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="fw-semibold">${row.proposedCode}</td>
                        <td>${row.proposedLabel || ''}</td>
                        <td><span class="badge ${badgeClass(row.Status)}">${row.Status}</span></td>
                        <td>${row.Reason || ''}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                ${editablePendingCreate ? `<button type="button" class="btn btn-outline-primary" onclick="openPendingCreateModal('${row.proposedCode}', ${JSON.stringify(String(row.proposedLabel || '')).replace(/"/g, '&quot;')})">Edit Draft</button>` : ''}
                                <a href="/admin/parameter-changes/${row.id}" class="btn btn-outline-secondary">Open Proposal</a>
                            </div>
                        </td>
                    `;
                    pendingBody.appendChild(tr);
                });
            }

            document.getElementById('liveSummary').textContent = `${filteredLive.length} live row(s)`;
            document.getElementById('pendingSummary').textContent = `${pendingCreates.length} pending create proposal(s)`;
        }

        function openCreateModal() {
            document.getElementById('formMode').value = 'create';
            document.getElementById('originalCode').value = '';
            document.getElementById('departmentModalTitle').textContent = 'Create Department Proposal';
            document.getElementById('departmentName').value = '';
            document.getElementById('departmentReason').value = '';
            departmentModal.show();
        }

        function openPendingCreateModal(code, name) {
            document.getElementById('formMode').value = 'create';
            document.getElementById('originalCode').value = code;
            document.getElementById('departmentModalTitle').textContent = `Edit Department Draft ${code}`;
            document.getElementById('departmentName').value = name || '';
            document.getElementById('departmentReason').value = '';
            departmentModal.show();
        }

        function openEditModal(code, name) {
            document.getElementById('formMode').value = 'edit';
            document.getElementById('originalCode').value = code;
            document.getElementById('departmentModalTitle').textContent = `Edit Department ${code}`;
            document.getElementById('departmentName').value = name || '';
            document.getElementById('departmentReason').value = '';
            departmentModal.show();
        }

        function openDeleteModal(code, canDelete) {
            if (!canDelete) {
                alert('This department is assigned to staff records and cannot be deleted.');
                return;
            }

            selectedDeleteCode = code;
            document.getElementById('deleteReason').value = '';
            deleteProposalModal.show();
        }

        async function saveDepartmentProposal() {
            const mode = document.getElementById('formMode').value;
            const code = document.getElementById('originalCode').value;
            const Dept = String(document.getElementById('departmentName').value || '').trim();
            const reason = String(document.getElementById('departmentReason').value || '').trim();

            if (!Dept) {
                alert('Department name is required.');
                return;
            }

            if (!reason) {
                alert('Please provide a reason for this change.');
                return;
            }

            const url = mode === 'create'
                ? '/admin/api/parameters/departments'
                : `/admin/api/parameters/departments/${encodeURIComponent(code)}`;
            const method = mode === 'create' ? 'POST' : 'PATCH';
            const payload = mode === 'create'
                ? { Code: code || undefined, Dept, reason }
                : { Dept, reason };

            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const json = await response.json();
            if (!response.ok) {
                throw new Error(json.error || 'Failed to save department proposal.');
            }

            departmentModal.hide();
            await loadDepartments();
            alert(json.message || 'Department proposal saved.');
        }

        async function saveDeleteProposal() {
            if (!selectedDeleteCode) {
                return;
            }

            const reason = String(document.getElementById('deleteReason').value || '').trim();
            if (!reason) {
                alert('Please provide a reason for this deletion proposal.');
                return;
            }

            const response = await fetch(`/admin/api/parameters/departments/${encodeURIComponent(selectedDeleteCode)}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            });
            const json = await response.json();
            if (!response.ok) {
                throw new Error(json.error || 'Failed to save deletion proposal.');
            }

            deleteProposalModal.hide();
            selectedDeleteCode = '';
            await loadDepartments();
            alert(json.message || 'Deletion proposal saved.');
        }

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('createDepartmentBtn').addEventListener('click', openCreateModal);
            document.getElementById('saveDepartmentBtn').addEventListener('click', async () => {
                try {
                    await saveDepartmentProposal();
                } catch (error) {
                    console.error(error);
                    alert(error.message || 'Failed to save department proposal.');
                }
            });
            document.getElementById('confirmDeleteProposalBtn').addEventListener('click', async () => {
                try {
                    await saveDeleteProposal();
                } catch (error) {
                    console.error(error);
                    alert(error.message || 'Failed to save deletion proposal.');
                }
            });
            document.getElementById('searchInput').addEventListener('input', renderTables);
            document.getElementById('statusFilter').addEventListener('change', renderTables);
            document.getElementById('resetFiltersBtn').addEventListener('click', () => {
                document.getElementById('searchInput').value = '';
                document.getElementById('statusFilter').value = '';
                renderTables();
            });

            try {
                await loadDepartments();
            } catch (error) {
                console.error(error);
                alert(error.message || 'Failed to load departments.');
            }
        });
    </script>
</body>
</html>
