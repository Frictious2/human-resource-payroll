<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · <%= group %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Payroll Activities / Pay Types</h2>
                    <div class="text-muted">Live `tblpaytype` values plus pending approval workflow state. No live activity is changed until final Entity Head/HNO approval.</div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/admin/parameter-changes?module=pay-types" class="btn btn-outline-secondary">Open Proposals</a>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#activityModal" id="createActivityBtn">
                        <i class="bi bi-plus-circle me-2"></i>Create Activity Proposal
                    </button>
                </div>
            </div>

            <div class="alert alert-warning">
                Approval applies this configuration to future system operations. Previously processed payroll will not be recalculated.
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Search</label>
                            <input id="searchInput" class="form-control" placeholder="Search code or activity name">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Workflow Status</label>
                            <select id="statusFilter" class="form-select">
                                <option value="">All</option>
                                <option value="DRAFT">Draft</option>
                                <option value="RETURNED_BY_ENTITY_HEAD">Returned</option>
                                <option value="SUBMITTED_TO_ENTITY_HEAD">Awaiting Approval</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button id="resetFiltersBtn" class="btn btn-outline-secondary w-100" type="button">Reset Filters</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Live Payroll Activities</span>
                    <span class="text-muted small" id="liveSummary">0 live rows</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="payTypesTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Activity Name</th>
                                    <th>Historical Usage</th>
                                    <th>Latest Pending Proposal</th>
                                    <th>Workflow Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Pending Create Proposals Not Yet In Live `tblpaytype`</span>
                    <span class="text-muted small" id="pendingSummary">0 draft create rows</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="pendingCreateTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Proposed Code</th>
                                    <th>Proposed Name</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th class="text-end">Open</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="activityModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="activityModalTitle">Create Payroll Activity Proposal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="activityForm">
                        <input type="hidden" id="formMode" value="create">
                        <input type="hidden" id="originalCode" value="">
                        <div class="mb-3">
                            <label class="form-label">Activity Code</label>
                            <input type="text" class="form-control" id="activityCode" maxlength="2" required>
                            <div class="form-text">Codes are treated as immutable after historical use.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Activity Name</label>
                            <input type="text" class="form-control" id="activityName" maxlength="50" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Reason for Change</label>
                            <textarea class="form-control" id="activityReason" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="saveActivityBtn">Save Proposal</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteProposalModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Propose Activity Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">This only creates a deletion proposal. The live activity remains unchanged unless the Entity Head/HNO approves it.</p>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" id="deleteReason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteProposalBtn">Save Deletion Proposal</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let liveRows = [];
        let pendingCreates = [];
        let selectedDeleteCode = '';

        const activityModal = new bootstrap.Modal(document.getElementById('activityModal'));
        const deleteProposalModal = new bootstrap.Modal(document.getElementById('deleteProposalModal'));

        async function loadPayTypes() {
            const response = await fetch('/admin/api/parameters/pay-types');
            const json = await response.json();
            if (!response.ok) {
                throw new Error(json.error || 'Failed to load payroll activities');
            }
            liveRows = json.data.liveRows || [];
            pendingCreates = json.data.pendingCreates || [];
            renderTables();
        }

        function badgeClass(status) {
            switch (status) {
                case 'DRAFT': return 'bg-secondary-subtle text-secondary-emphasis';
                case 'RETURNED_BY_ENTITY_HEAD': return 'bg-info-subtle text-info-emphasis';
                case 'SUBMITTED_TO_ENTITY_HEAD': return 'bg-warning-subtle text-warning-emphasis';
                case 'APPLIED': return 'bg-success-subtle text-success-emphasis';
                default: return 'bg-light text-dark';
            }
        }

        function renderTables() {
            const term = String(document.getElementById('searchInput').value || '').toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;

            const filteredLive = liveRows.filter((row) => {
                const matchesText = [row.Code, row.PayType, row.latestPendingStatus || ''].some((value) => String(value || '').toLowerCase().includes(term));
                const matchesStatus = !statusFilter || row.latestPendingStatus === statusFilter;
                return matchesText && matchesStatus;
            });

            const tbody = document.querySelector('#payTypesTable tbody');
            tbody.innerHTML = '';
            if (!filteredLive.length) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No payroll activities found.</td></tr>';
            } else {
                filteredLive.forEach((row) => {
                    const tr = document.createElement('tr');
                    const requestUrl = row.latestPendingRequest ? `/admin/parameter-changes/${row.latestPendingRequest.id}` : '';
                    tr.innerHTML = `
                        <td class="fw-semibold">${row.Code}</td>
                        <td>${row.PayType || ''}</td>
                        <td>
                            <div>${row.usage.total || 0} reference(s)</div>
                            <div class="small text-muted">
                                Payroll: ${row.usage.tblPayroll || 0}, Yearly: ${row.usage.tblyearlypayments || 0}, Increment: ${row.usage.tblincrement || 0}
                            </div>
                        </td>
                        <td>${row.latestPendingRequest ? `${row.latestPendingRequest.ChangeType} proposal` : '<span class="text-muted">None</span>'}</td>
                        <td>${row.latestPendingStatus ? `<span class="badge ${badgeClass(row.latestPendingStatus)}">${row.latestPendingStatus}</span>` : '<span class="text-muted">—</span>'}</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-primary" onclick="openEditModal('${row.Code}', ${JSON.stringify(String(row.PayType || '')).replace(/"/g, '&quot;')})">Edit</button>
                                ${requestUrl ? `<a class="btn btn-outline-secondary" href="${requestUrl}">Proposal</a>` : ''}
                                <button type="button" class="btn btn-outline-danger" onclick="openDeleteModal('${row.Code}', ${row.canDelete ? 'true' : 'false'})">Delete</button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }

            const pendingBody = document.querySelector('#pendingCreateTable tbody');
            pendingBody.innerHTML = '';
            if (!pendingCreates.length) {
                pendingBody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No pending create proposals are waiting outside the live table.</td></tr>';
            } else {
                pendingCreates.forEach((row) => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="fw-semibold">${row.proposedCode}</td>
                        <td>${row.proposedName || ''}</td>
                        <td><span class="badge ${badgeClass(row.Status)}">${row.Status}</span></td>
                        <td>${row.Reason || ''}</td>
                        <td class="text-end"><a href="/admin/parameter-changes/${row.id}" class="btn btn-sm btn-outline-secondary">Open Proposal</a></td>
                    `;
                    pendingBody.appendChild(tr);
                });
            }

            document.getElementById('liveSummary').textContent = `${filteredLive.length} live row(s)`;
            document.getElementById('pendingSummary').textContent = `${pendingCreates.length} pending create proposal(s)`;
        }

        function openCreateModal() {
            document.getElementById('formMode').value = 'create';
            document.getElementById('originalCode').value = '';
            document.getElementById('activityModalTitle').textContent = 'Create Payroll Activity Proposal';
            document.getElementById('activityCode').disabled = false;
            document.getElementById('activityCode').value = '';
            document.getElementById('activityName').value = '';
            document.getElementById('activityReason').value = '';
            activityModal.show();
        }

        window.openEditModal = function(code, payType) {
            document.getElementById('formMode').value = 'edit';
            document.getElementById('originalCode').value = code;
            document.getElementById('activityModalTitle').textContent = 'Propose Payroll Activity Edit';
            document.getElementById('activityCode').value = code;
            document.getElementById('activityCode').disabled = true;
            document.getElementById('activityName').value = payType;
            document.getElementById('activityReason').value = '';
            activityModal.show();
        };

        window.openDeleteModal = function(code, canDelete) {
            if (!canDelete) {
                alert('This payroll activity has historical transaction records and cannot be deleted.');
                return;
            }
            selectedDeleteCode = code;
            document.getElementById('deleteReason').value = '';
            deleteProposalModal.show();
        };

        async function saveProposal() {
            const mode = document.getElementById('formMode').value;
            const code = document.getElementById('activityCode').value.trim();
            const payType = document.getElementById('activityName').value.trim();
            const reason = document.getElementById('activityReason').value.trim();

            if (!code || !payType || !reason) {
                alert('Activity code, name, and reason are required.');
                return;
            }

            const url = mode === 'create' ? '/admin/parameters/pay-types' : `/admin/parameters/pay-types/${encodeURIComponent(document.getElementById('originalCode').value)}`;
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Code: code, PayType: payType, reason })
            });
            const json = await response.json();
            if (!response.ok) {
                alert(json.error || json.message || 'Failed to save proposal.');
                return;
            }

            activityModal.hide();
            await loadPayTypes();
            alert(json.message || 'Proposal saved successfully.');
        }

        async function saveDeleteProposal() {
            const reason = document.getElementById('deleteReason').value.trim();
            if (!selectedDeleteCode || !reason) {
                alert('A deletion reason is required.');
                return;
            }

            const response = await fetch(`/admin/parameters/pay-types/${encodeURIComponent(selectedDeleteCode)}/delete`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            });
            const json = await response.json();
            if (!response.ok) {
                alert(json.error || json.message || 'Failed to save deletion proposal.');
                return;
            }

            deleteProposalModal.hide();
            await loadPayTypes();
            alert(json.message || 'Deletion proposal saved successfully.');
        }

        document.addEventListener('DOMContentLoaded', async () => {
            document.getElementById('createActivityBtn').addEventListener('click', openCreateModal);
            document.getElementById('saveActivityBtn').addEventListener('click', saveProposal);
            document.getElementById('confirmDeleteProposalBtn').addEventListener('click', saveDeleteProposal);
            document.getElementById('searchInput').addEventListener('input', renderTables);
            document.getElementById('statusFilter').addEventListener('change', renderTables);
            document.getElementById('resetFiltersBtn').addEventListener('click', () => {
                document.getElementById('searchInput').value = '';
                document.getElementById('statusFilter').value = '';
                renderTables();
            });

            try {
                await loadPayTypes();
                <% if (createMode) { %>openCreateModal();<% } %>
                <% if (editCode) { %>
                    const row = liveRows.find((item) => String(item.Code) === <%- JSON.stringify(String(editCode)) %>);
                    if (row) {
                        openEditModal(row.Code, row.PayType || '');
                    }
                <% } %>
            } catch (error) {
                console.error(error);
                alert(error.message || 'Failed to load payroll activities.');
            }
        });
    </script>
</body>
</html>
