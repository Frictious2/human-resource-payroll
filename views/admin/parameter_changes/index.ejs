<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> · HR & Payroll</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/styles.css" rel="stylesheet" />
</head>
<body>
    <%- include('../partials/topbar', { user }) %>
    <%- include('../partials/sidebar') %>

    <main class="main">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
                <div>
                    <h2 class="mb-1">Parameter Change Proposals</h2>
                    <div class="text-muted">Drafts, returned proposals, and applied parameter changes for the Administrator.</div>
                </div>
                <a href="/admin/parameters/global-params" class="btn btn-outline-primary">Open parameter pages</a>
            </div>

            <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
            <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <form class="row g-3" method="get" action="/admin/parameter-changes">
                        <div class="col-md-4">
                            <label class="form-label">Module</label>
                            <select name="module" class="form-select">
                                <option value="">All modules</option>
                                <% moduleOptions.forEach((option) => { %>
                                    <option value="<%= option.value %>" <%= filters.module === option.value ? 'selected' : '' %>><%= option.label %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All statuses</option>
                                <% statusOptions.forEach((status) => { %>
                                    <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary">Apply Filters</button>
                            <a href="/admin/parameter-changes" class="btn btn-outline-secondary">Reset</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Change Queue</span>
                    <span class="text-muted small"><%= items.length %> request(s)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Module</th>
                                    <th>Change</th>
                                    <th>Reference</th>
                                    <th>Status</th>
                                    <th>Submitted</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!items.length) { %>
                                    <tr><td colspan="6" class="text-center text-muted py-4">No parameter changes found for the current filters.</td></tr>
                                <% } %>
                                <% items.forEach((item) => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-semibold"><%= item.moduleLabel %></div>
                                            <div class="small text-muted"><%= item.classification %></div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border"><%= item.ChangeType %></span></td>
                                        <td><code><%= item.RecordReference %></code></td>
                                        <td><span class="badge <%= item.badgeClass %>"><%= item.Status %></span></td>
                                        <td><%= item.SubmittedAt ? new Date(item.SubmittedAt).toLocaleString('en-GB') : 'Draft only' %></td>
                                        <td class="text-end"><a href="/admin/parameter-changes/<%= item.id %>" class="btn btn-sm btn-outline-primary">Open</a></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <span class="fw-semibold">Controlled Parameter Discovery Matrix</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Module</th>
                                    <th>Source Table</th>
                                    <th>Admin Page</th>
                                    <th>Source Key</th>
                                    <th>Classification</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% discoveryMatrix.forEach((row) => { %>
                                    <tr>
                                        <td><%= row.module %></td>
                                        <td><code><%= row.sourceTable %></code></td>
                                        <td><a href="<%= row.adminRoute %>"><%= row.adminRoute %></a></td>
                                        <td><%= row.sourceKey %></td>
                                        <td><%= row.classification %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
