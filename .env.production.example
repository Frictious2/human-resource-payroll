NODE_ENV=production
PORT=3001
APP_BASE_URL=https://hr.example.org

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personnel_master
DB_USER=hrpayroll
DB_PASSWORD=replace-with-database-password

# Generate at deployment time, for example: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=hrpayroll.sid
SESSION_MAX_AGE_MS=28800000
SESSION_CLEANUP_INTERVAL_MS=900000

# Set to the exact number of trusted reverse proxies between users and Express.
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# In-app notifications remain active when email delivery is disabled.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
