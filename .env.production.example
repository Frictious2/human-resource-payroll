# Copy to the project-root .env on the server. Never commit the populated file.
NODE_ENV=production
INSTALLATION_COMPANY_ID=1
PORT=3001
APP_HOST=127.0.0.1
APP_BASE_URL=https://staging.example.org
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personnel_master_staging
DB_USER=hrpayroll_staging
DB_PASSWORD=
SESSION_SECRET=
# Required at production startup. Use an independent random secret (32+ characters).
RESET_TOKEN_SECRET=
SESSION_COOKIE_NAME=hrpayroll.sid
SESSION_MAX_AGE_MS=28800000
# Bounded automatic cleanup of expired sessions.
SESSION_CLEANUP_INTERVAL_MS=900000
SESSION_CLEANUP_BATCH_SIZE=100
SHUTDOWN_TIMEOUT_MS=30000
PRIVATE_UPLOAD_DIR=/home/CPANEL_USER/waec-private/uploads
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
EMAIL_NOTIFICATIONS_ENABLED=false
# Enable after SMTP credentials are configured; disabled mail cannot provision accounts.
ACCOUNT_EMAIL_ENABLED=false
# All SMTP_* settings are project .env-only, never inherited from OS variables.
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
TZ=Africa/Freetown
# New private uploads use PRIVATE_UPLOAD_DIR outside public. Do not move legacy files
# until an authorized migration with backup has been completed.
# Configure logs in systemd/journald and backups in a protected off-webroot directory.
